<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GENERAL ACCOUNTS - Ideal Technical Training & Testing Center</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "SolaimanLipi", "Nikosh", "Segoe UI", Tahoma, sans-serif;
    }

    :root {
      --bg: #090d16;
      --panel: #0f172a;
      --card: #131c2e;
      --border: #24324a;
      --accent: #f97316;
      --blue: #3b82f6;
      --green: #22c55e;
      --red: #ef4444;
      --text: #f8fafc;
      --muted: #94a3b8;
    }

    body {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 16px;
    }

    .container {
      max-width: 1480px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    /* Top Header & Navigation Tabs */
    .topbar {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 13px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .topbar h1 {
      font-size: 16px;
      font-weight: 700;
      color: var(--accent);
    }

    .topbar p {
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
    }

    .nav-tabs {
      display: flex;
      gap: 8px;
      background: var(--panel);
      padding: 5px;
      border-radius: 9px;
      border: 1px solid var(--border);
    }

    .tab-btn {
      background: transparent;
      color: var(--muted);
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .tab-btn.active {
      background: var(--accent);
      color: #ffffff;
    }

    .topbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }

    .btn {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 7px;
      padding: 8px 13px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-green { background: #16a34a; }
    .btn-blue { background: #2563eb; }
    .btn-secondary {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .view-section {
      display: none;
      flex-direction: column;
      gap: 14px;
    }

    .view-section.active {
      display: flex;
    }

    /* Dashboard Summary View */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
    }

    .card-title {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 10px;
    }

    .kpi-label {
      font-size: 11.5px;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .kpi-value {
      font-size: 21px;
      font-weight: 700;
    }

    .kpi-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 5px;
    }

    .income-text { color: var(--green); }
    .expense-text { color: var(--red); }

    .dashboard-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .breakdown-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .breakdown-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 12.5px;
    }

    .breakdown-row-top {
      display: flex;
      justify-content: space-between;
      gap: 8px;
    }

    .progress-track {
      height: 7px;
      background: var(--panel);
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill-income {
      height: 100%;
      background: var(--green);
    }

    .progress-fill-expense {
      height: 100%;
      background: var(--red);
    }

    .summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12.5px;
    }

    .summary-table th,
    .summary-table td {
      padding: 9px 10px;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }

    .summary-table th {
      color: var(--muted);
      font-size: 11.5px;
    }

    /* Accounts Sheet View */
    .workspace {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 14px;
      align-items: start;
    }

    .form-grid {
      display: flex;
      flex-direction: column;
      gap: 9px;
      margin-top: 8px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .field label {
      font-size: 11.5px;
      color: var(--muted);
    }

    .field input,
    .field select {
      background: var(--panel);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 6px;
      padding: 7px 10px;
      font-size: 12.5px;
      outline: none;
    }

    .sheet-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }

    .filter-group {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .filter-group input,
    .filter-group select {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 12px;
      outline: none;
    }

    /* Exact Excel Sheet Style */
    .excel-container {
      background: #ffffff;
      color: #000000;
      border: 2px solid #1d4ed8;
      padding: 8px;
      overflow-x: auto;
      border-radius: 4px;
    }

    .excel-sheet-header {
      text-align: center;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 6px;
      color: #000000;
    }

    table.excel-table {
      width: 100%;
      min-width: 960px;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 11px;
      color: #000000;
    }

    table.excel-table th,
    table.excel-table td {
      border: 1px solid #000000;
      padding: 2px 4px;
      height: 21px;
      vertical-align: middle;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .hdr-peach {
      background-color: #f4b084;
      font-weight: 700;
      text-align: center;
    }

    .bg-green {
      background-color: #00b050 !important;
      color: #000000;
      font-weight: 700;
    }

    .bg-yellow {
      background-color: #ffff00 !important;
      color: #000000;
      font-weight: 700;
    }

    .text-center { text-align: center; }
    .text-right { text-align: right; }
    .bold { font-weight: 700; }

    td[contenteditable="true"]:focus {
      outline: 2px solid #16a34a;
      background-color: #f0fdf4;
    }

    .row-del-btn {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fca5a5;
      border-radius: 3px;
      font-size: 10px;
      padding: 0 4px;
      cursor: pointer;
    }

    @media (max-width: 1080px) {
      .kpi-grid { grid-template-columns: repeat(2, 1fr); }
      .dashboard-grid-2,
      .workspace { grid-template-columns: 1fr; }
    }

    @page {
      size: A4 landscape;
      margin: 6mm;
    }

    @media print {
      body {
        background: #ffffff !important;
        color: #000000 !important;
        padding: 0 !important;
      }
      .topbar,
      #dashboardView,
      .workspace > .card:first-child,
      .sheet-controls,
      .no-print {
        display: none !important;
      }
      #sheetView {
        display: block !important;
      }
      .container,
      .workspace,
      .workspace > .card:last-child {
        display: block !important;
        background: #ffffff !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
      }
      .excel-container {
        border: 1.5px solid #000000 !important;
        padding: 4px !important;
        overflow: visible !important;
      }
      table.excel-table {
        min-width: 100% !important;
        font-size: 9.5px !important;
      }
      table.excel-table th,
      table.excel-table td {
        height: 18px !important;
        padding: 2px 4px !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Top Header with 2 Main Options -->
    <header class="topbar">
      <div>
        <h1>GENERAL ACCOUNTS</h1>
        <p>IDEAL TECHNICAL TRAINING &amp; TESTING CENTER (itttc.com)</p>
      </div>

      <!-- ২টি আলাদা অপশন: ১. হিসাবের সামারি (ড্যাশবোর্ড) ২. হিসাব খাতা (Excel শীট) -->
      <div class="nav-tabs">
        <button type="button" class="tab-btn active" data-target="dashboardView">📊 হিসাবের সামারি (Dashboard)</button>
        <button type="button" class="tab-btn" data-target="sheetView">📑 হিসাব খাতা (Excel শীট)</button>
      </div>

      <div class="topbar-actions">
        <button type="button" class="btn btn-blue" id="exportJsonBtn">💾 Backup</button>
        <button type="button" class="btn btn-secondary" id="importJsonBtn">📂 Restore</button>
        <input type="file" id="jsonFileInput" accept="application/json" style="display:none;" />
        <button type="button" class="btn" id="printPdfBtn">📄 Download PDF</button>
      </div>
    </header>

    <!-- অপশন ১: হিসাবের সামারি দেখার জন্য ড্যাশবোর্ড -->
    <section class="view-section active" id="dashboardView">
      <div class="kpi-grid">
        <div class="card">
          <div class="kpi-label">মোট নগদ টাকা (পূর্বের ব্যালেন্সসহ)</div>
          <div class="kpi-value income-text" id="cardTotalCash">৳২৭৯৮২৩</div>
          <div class="kpi-sub" id="subCashInfo">পূর্বের নগদ + নতুন নগদ আয়</div>
        </div>
        <div class="card">
          <div class="kpi-label">মোট ব্যয়ের টাকা</div>
          <div class="kpi-value expense-text" id="cardTotalExpense">৳২৫১৩১০</div>
          <div class="kpi-sub">ব্যাংক জমা ও সকল খরচসহ</div>
        </div>
        <div class="card">
          <div class="kpi-label">ব্যাংকে জমা আছে</div>
          <div class="kpi-value" id="cardTotalBank">৳৭৬৭৫৭০</div>
          <div class="kpi-sub">বর্তমান মোট ব্যাংক ব্যালেন্স</div>
        </div>
        <div class="card">
          <div class="kpi-label">নগদ ব্যালেন্স / (নগদ + ব্যাংক)</div>
          <div class="kpi-value" id="cardNetBalance">৳২৮৫১৩ / ৳৭৯৬০৮৩</div>
          <div class="kpi-sub">হাতে নগদ ও সর্বমোট স্থিতি</div>
        </div>
      </div>

      <div class="dashboard-grid-2">
        <div class="card">
          <div class="card-title">শীর্ষ আয়ের খাতসমূহ (Income Summary)</div>
          <div class="breakdown-list" id="topIncomeList"></div>
        </div>

        <div class="card">
          <div class="card-title">শীর্ষ ব্যয়ের খাতসমূহ (Expense Summary)</div>
          <div class="breakdown-list" id="topExpenseList"></div>
        </div>
      </div>

      <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:8px;">
          <div class="card-title" style="margin-bottom:0;">তারিখ ভিত্তিক হিসাবের সারাংশ (Date-wise Summary)</div>
          <button type="button" class="btn btn-green" onclick="switchTab('sheetView')">+ নতুন হিসাব লিখতে Excel শীটে যান →</button>
        </div>
        <table class="summary-table">
          <thead>
            <tr>
              <th>তারিখ</th>
              <th>মোট নগদ আয়</th>
              <th>ব্যাংকে জমা</th>
              <th>মোট ব্যয়</th>
              <th>লেনদেন সংখ্যা</th>
            </tr>
          </thead>
          <tbody id="dateSummaryBody"></tbody>
        </table>
      </div>
    </section>

    <!-- অপশন ২: হিসাব করার জন্য Excel শীট ও এন্ট্রি ফর্ম -->
    <section class="view-section" id="sheetView">
      <div class="workspace">
        <div class="card">
          <h2 style="font-size:14px; color:var(--accent);">নতুন হিসাব এন্ট্রি</h2>
          <p style="font-size:11px; color:var(--muted); margin-top:2px;">হিসাব যুক্ত করলে Excel শীট ও ড্যাশবোর্ড সামারি অটো আপডেট হবে</p>

          <form class="form-grid" id="entryForm">
            <div class="field">
              <label for="fDate">তারিখ</label>
              <input type="text" id="fDate" value="২২.১১.২০২৬" required />
            </div>

            <div class="field">
              <label for="fEntryType">এন্ট্রির ধরন</label>
              <select id="fEntryType">
                <option value="incomeCash">আয় — নগদ টাকা</option>
                <option value="expenseCash">ব্যয় — ব্যয়ের টাকা</option>
                <option value="bankDeposit">ব্যাংকে জমা (নগদ থেকে ব্যাংকে)</option>
              </select>
            </div>

            <div class="field">
              <label for="fDesc">আয় বা ব্যয়ের মাধ্যম (বিবরণ)</label>
              <input type="text" id="fDesc" placeholder="যেমন: জব ফি বা গাড়ি ভাড়া" required />
            </div>

            <div class="field">
              <label for="fAmount">টাকার পরিমাণ</label>
              <input type="number" id="fAmount" min="1" placeholder="যেমন: 10000" required />
            </div>

            <button type="submit" class="btn">+ Excel শীটে যুক্ত করুন</button>
          </form>
        </div>

        <div class="card">
          <div class="sheet-controls">
            <div class="filter-group">
              <input type="text" id="searchInput" placeholder="তারিখ বা বিবরণ খুঁজুন..." />
              <select id="filterMode">
                <option value="all">সব সারি দেখুন</option>
                <option value="income">শুধু আয়ের সারি</option>
                <option value="expense">শুধু ব্যয়ের সারি</option>
              </select>
            </div>
            <div style="display:flex; gap:8px;">
              <button type="button" class="btn btn-green" id="addBlankRowBtn">+ খালি সারি</button>
              <button type="button" class="btn btn-secondary" id="resetSampleBtn">Sample Data</button>
            </div>
          </div>

          <div class="excel-container">
            <div class="excel-sheet-header">IDEAL TECHNICAL TRAINING &amp; TESTING CENTER — GENERAL ACCOUNTS</div>

            <table class="excel-table" id="excelTable">
              <colgroup>
                <col style="width: 68px;" />
                <col style="width: 185px;" />
                <col style="width: 62px;" />
                <col style="width: 62px;" />
                <col style="width: 205px;" />
                <col style="width: 62px;" />
                <col style="width: 62px;" />
                <col style="width: 62px;" />
                <col style="width: 62px;" />
                <col style="width: 66px;" />
                <col style="width: 68px;" />
                <col class="no-print" style="width: 26px;" />
              </colgroup>

              <thead>
                <tr>
                  <th class="hdr-peach" rowspan="2">তারিখ</th>
                  <th class="hdr-peach" colspan="3">আয়</th>
                  <th class="hdr-peach" colspan="2">ব্যয়</th>
                  <th class="hdr-peach" rowspan="2">নগদ টাকা</th>
                  <th class="hdr-peach" rowspan="2">ব্যয়ের টাকা</th>
                  <th class="hdr-peach" rowspan="2">ব্যাংকে জমা</th>
                  <th class="hdr-peach" rowspan="2">নগদ ব্যালেন্স</th>
                  <th class="hdr-peach" rowspan="2">নগদ +<br />ব্যাংক</th>
                  <th class="hdr-peach no-print" rowspan="2">×</th>
                </tr>
                <tr>
                  <th class="hdr-peach">আয়ের মাধ্যম</th>
                  <th class="hdr-peach">নগদ টাকা</th>
                  <th class="hdr-peach">ব্যাংকে জমা</th>
                  <th class="hdr-peach">ব্যয়ের মাধ্যম</th>
                  <th class="hdr-peach">ব্যয়ের টাকা</th>
                </tr>
              </thead>

              <tbody id="sheetBody"></tbody>

              <tfoot>
                <tr>
                  <td></td>
                  <td class="bold">ব্যাংকে জমা আছে=</td>
                  <td></td>
                  <td></td>
                  <td class="text-right bold">ব্যাংক জমা আছে</td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td class="no-print"></td>
                </tr>
                <tr>
                  <td></td>
                  <td></td>
                  <td class="text-center bg-green" id="totInCashLeft">২৭৯৮২৩</td>
                  <td class="text-center bg-green" id="totInBankLeft">৭৬৭৫৭০</td>
                  <td class="text-right bold">ক্যাশে জমা আছে=</td>
                  <td class="text-center bg-yellow" id="totOutLeft">২৫১৩১০</td>
                  <td class="text-center bg-green" id="totInCashRight">২৭৯৮২৩</td>
                  <td class="text-center bg-yellow" id="totOutRight">২৫১৩১০</td>
                  <td class="text-center bg-green" id="totInBankRight">৭৬৭৫৭০</td>
                  <td class="text-center bg-green" id="netCashBalance">২৮৫১৩</td>
                  <td class="text-center bg-green" id="netCashPlusBank">৭৯৬০৮৩</td>
                  <td class="no-print"></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    const STORAGE_KEY = "itttc_general_accounts_two_tabs_v1";

    const defaultRows = [
      { isOpening: true, date: "২১.১১.২০২৬", inDesc: "পূর্বের ব্যালেন্স", inCash: "২১৫৪২৩", inBank: "৫৪৩৫৭০", outDesc: "পূর্বের ব্যালেন্স", outCash: "" },
