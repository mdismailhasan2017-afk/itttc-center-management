<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GENERAL ACCOUNTS - ITTC Center</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "SolaimanLipi", "Nikosh", "Segoe UI", Tahoma, sans-serif;
    }

    :root {
      --bg: #050b0e;
      --sidebar: #081216;
      --panel: #0b191e;
      --card: #0d1f25;
      --border: #17353f;
      --accent: #10b981;
      --accent-soft: rgba(16, 185, 129, 0.16);
      --orange: #f97316;
      --blue: #3b82f6;
      --green: #22c55e;
      --red: #ef4444;
      --purple: #a855f7;
      --text: #f1f5f9;
      --muted: #8aa0ab;
    }

    body {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* Password Lock Screen */
    .lock-screen {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: radial-gradient(circle at top, #0d262e 0%, #050b0e 70%);
    }

    .lock-card {
      width: 100%;
      max-width: 390px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .lock-badge {
      display: inline-block;
      width: fit-content;
      background: var(--accent-soft);
      color: var(--accent);
      border: 1px solid rgba(16, 185, 129, 0.35);
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    .lock-card h1 {
      font-size: 18px;
      color: var(--text);
    }

    .lock-card p {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.5;
    }

    .lock-input {
      width: 100%;
      background: var(--panel);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 14px;
      outline: none;
    }

    .lock-input:focus {
      border-color: var(--accent);
    }

    .lock-error {
      color: #f87171;
      font-size: 12px;
      min-height: 16px;
    }

    /* Main App Layout (Dark Sidebar + Topbar like Image) */
    .app-shell {
      display: none;
      min-height: 100vh;
    }

    .app-shell.unlocked {
      display: grid;
      grid-template-columns: 235px 1fr;
    }

    .sidebar {
      background: var(--sidebar);
      border-right: 1px solid var(--border);
      padding: 14px 10px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
    }

    .brand-box {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 8px 12px 8px;
      border-bottom: 1px solid var(--border);
    }

    .brand-logo {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 12px;
    }

    .brand-title {
      font-size: 13px;
      font-weight: 700;
    }

    .brand-sub {
      font-size: 10.5px;
      color: var(--muted);
    }

    .nav-list {
      display: flex;
      flex-direction: column;
      gap: 5px;
      margin-top: 10px;
    }

    .nav-btn {
      width: 100%;
      text-align: left;
      background: transparent;
      color: var(--muted);
      border: 1px solid transparent;
      border-radius: 7px;
      padding: 9px 11px;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-btn:hover {
      background: var(--panel);
      color: var(--text);
    }

    .nav-btn.active {
      background: var(--accent);
      color: #04100c;
      font-weight: 700;
    }

    .main-content {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .topbar {
      background: var(--sidebar);
      border-bottom: 1px solid var(--border);
      padding: 10px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .topbar-left h2 {
      font-size: 15px;
      font-weight: 700;
    }

    .topbar-left span {
      font-size: 11px;
      color: var(--muted);
    }

    .topbar-right {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }

    .btn {
      background: var(--accent);
      color: #04100c;
      border: none;
      border-radius: 6px;
      padding: 7px 12px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-orange {
      background: var(--orange);
      color: #ffffff;
    }

    .btn-blue {
      background: #2563eb;
      color: #ffffff;
    }

    .btn-secondary {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .page-body {
      padding: 14px 18px 24px 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .tab-pane {
      display: none;
      flex-direction: column;
      gap: 14px;
    }

    .tab-pane.active {
      display: flex;
    }

    /* Dashboard Cards */
    .kpi-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .kpi-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 13px 15px;
    }

    .card-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 10px;
    }

    .kpi-label {
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 5px;
    }

    .kpi-value {
      font-size: 20px;
      font-weight: 700;
    }

    .kpi-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px;
    }

    .income-text { color: var(--green); }
    .expense-text { color: var(--red); }
    .blue-text { color: #60a5fa; }
    .purple-text { color: #c084fc; }

    /* 3 Officials Separate Graphs */
    .officials-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .official-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 13px 15px;
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .official-role {
      font-size: 10.5px;
      font-weight: 700;
      color: var(--muted);
    }

    .official-name {
      font-size: 14.5px;
      font-weight: 700;
    }

    .official-amount {
      font-size: 21px;
      font-weight: 700;
    }

    .graph-box {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px;
      height: 145px;
      display: flex;
      align-items: flex-end;
      gap: 8px;
    }

    .bar-col {
      flex: 1;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      gap: 4px;
    }

    .bar-fill {
      width: 100%;
      max-width: 34px;
      border-radius: 4px 4px 0 0;
      min-height: 4px;
    }

    .bar-val {
      font-size: 10px;
      font-weight: 700;
    }

    .bar-lbl {
      font-size: 9.5px;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    .official-form {
      display: flex;
      gap: 6px;
    }

    .official-form input {
      flex: 1;
      background: var(--panel);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 6px;
      padding: 6px 8px;
      font-size: 12px;
      outline: none;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    .summary-table th,
    .summary-table td {
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }

    .summary-table th {
      color: var(--muted);
      font-size: 11px;
    }

    /* Sheet Tab */
    .workspace {
      display: grid;
      grid-template-columns: 295px 1fr;
      gap: 12px;
      align-items: start;
    }

    .form-grid {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 8px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .field label {
      font-size: 11.5px;
      color: var(--muted);
    }

    .field input,
    .field select {
      background: var(--panel);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 6px;
      padding: 7px 9px;
      font-size: 12px;
      outline: none;
    }

    .sheet-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }

    .filter-group {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .filter-group input,
    .filter-group select {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 12px;
      outline: none;
    }

    /* Exact Excel Sheet Style */
    .excel-container {
      background: #ffffff;
      color: #000000;
      border: 2px solid #1d4ed8;
      padding: 8px;
      overflow-x: auto;
      border-radius: 4px;
    }

    .excel-sheet-header {
      text-align: center;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 6px;
      color: #000000;
    }

    table.excel-table {
      width: 100%;
      min-width: 960px;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 11px;
      color: #000000;
    }

    table.excel-table th,
    table.excel-table td {
      border: 1px solid #000000;
      padding: 2px 4px;
      height: 21px;
      vertical-align: middle;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .hdr-peach {
      background-color: #f4b084;
      font-weight: 700;
      text-align: center;
    }

    .bg-green {
      background-color: #00b050 !important;
      color: #000000;
      font-weight: 700;
    }

    .bg-yellow {
      background-color: #ffff00 !important;
      color: #000000;
      font-weight: 700;
    }

    .text-center { text-align: center; }
    .text-right { text-align: right; }
    .bold { font-weight: 700; }

    td[contenteditable="true"]:focus {
      outline: 2px solid #16a34a;
      background-color: #f0fdf4;
    }

    .row-del-btn {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fca5a5;
      border-radius: 3px;
      font-size: 10px;
      padding: 0 4px;
      cursor: pointer;
    }

    @media (max-width: 1100px) {
      .app-shell.unlocked { grid-template-columns: 1fr; }
      .officials-grid,
      .kpi-grid-3,
      .grid-2,
      .workspace { grid-template-columns: 1fr; }
      .kpi-grid-4 { grid-template-columns: repeat(2, 1fr); }
    }

    @page {
      size: A4 landscape;
      margin: 6mm;
    }

    @media print {
      body {
        background: #ffffff !important;
        color: #000000 !important;
        padding: 0 !important;
      }
      .lock-screen,
      .sidebar,
      .topbar,
      #dashboardPane,
      .workspace > .card:first-child,
      .sheet-controls,
      .no-print {
        display: none !important;
      }
      .app-shell.unlocked,
      .main-content,
      .page-body,
      #sheetPane,
      .workspace,
      .workspace > .card:last-child {
        display: block !important;
        background: #ffffff !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      .excel-container {
        border: 1.5px solid #000000 !important;
        padding: 4px !important;
        overflow: visible !important;
      }
      table.excel-table {
        min-width: 100% !important;
        font-size: 9.5px !important;
      }
      table.excel-table th,
      table.excel-table td {
        height: 18px !important;
        padding: 2px 4px !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }
  </style>
</head>
<body>

  <!-- ১. GENERAL ACCOUNTS পাসওয়ার্ড লক স্ক্রিন -->
  <div class="lock-screen" id="lockScreen">
    <form class="lock-card" id="unlockForm">
      <span class="lock-badge">PROTECTED MODULE</span>
      <h1>GENERAL ACCOUNTS</h1>
      <p>IDEAL TECHNICAL TRAINING &amp; TESTING CENTER — হিসাব বিভাগে প্রবেশ করতে পাসওয়ার্ড দিন (ডিফল্ট পাসওয়ার্ড: <strong>1234</strong>)</p>
      <input type="password" class="lock-input" id="passwordInput" placeholder="পাসওয়ার্ড লিখুন..." required autofocus />
      <div class="lock-error" id="lockError"></div>
      <button type="submit" class="btn">🔓 লগইন করে প্রবেশ করুন</button>
    </form>
  </div>

  <!-- ২. লগইন করার পর GENERAL ACCOUNTS (শুধু হিসাব সংক্রান্ত লেনদেন, কোনো টোকেন অপশন নেই) -->
  <div class="app-shell" id="appShell">
    <aside class="sidebar">
      <div>
        <div class="brand-box">
          <div class="brand-logo">GA</div>
          <div>
            <div class="brand-title">GENERAL ACCOUNTS</div>
            <div class="brand-sub">ITTC Center • Accounts Only</div>
          </div>
        </div>

        <div class="nav-list">
          <button type="button" class="nav-btn active" data-pane="dashboardPane">
            <span>📊 হিসাব সামারি (Dashboard)</span>
          </button>
          <button type="button" class="nav-btn" data-pane="sheetPane">
            <span>📑 হিসাব লেনদেন (Excel শীট)</span>
          </button>
        </div>
      </div>

      <button type="button" class="btn btn-secondary" id="lockBtn">🔒 Lock Accounts</button>
    </aside>

    <div class="main-content">
      <header class="topbar">
        <div class="topbar-left">
          <h2>IDEAL TECHNICAL TRAINING &amp; TESTING CENTER</h2>
          <span>GENERAL ACCOUNTS • হিসাব লেনদেন ও সামারি</span>
        </div>

        <div class="topbar-right">
          <select id="dashDateFilter" style="background:var(--panel); color:var(--text); border:1px solid var(--border); padding:6px 10px; border-radius:6px; font-size:12px;">
            <option value="ALL">সব তারিখ</option>
            <option value="২২.১১.২০২৬" selected>তারিখ: ২২.১১.২০২৬</option>
          </select>
          <button type="button" class="btn btn-blue" id="exportJsonBtn">💾 Backup</button>
          <button type="button" class="btn btn-secondary" id="importJsonBtn">📂 Restore</button>
          <input type="file" id="jsonFileInput" accept="application/json" style="display:none;" />
          <button type="button" class="btn btn-orange" id="printPdfBtn">📄 Download PDF</button>
        </div>
      </header>

      <div class="page-body">
        <!-- ট্যাব ১: হিসাব সামারি ড্যাশবোর্ড -->
        <section class="tab-pane active" id="dashboardPane">
          <div class="kpi-grid-3">
            <div class="card">
              <div class="kpi-label">১. দৈনিক PP (PPE) বাবদ জমা</div>
              <div class="kpi-value income-text" id="ppDepositVal">৳৪০০০</div>
              <div class="kpi-sub">দৈনিক PP / পিপিই ফি জমা</div>
            </div>
            <div class="card">
              <div class="kpi-label">২. WELDING JOB FEE বাবদ জমা</div>
              <div class="kpi-value blue-text" id="weldingJobFeeVal">৳৪৫৪০০</div>
              <div class="kpi-sub">দৈনিক Welding Job Fee জমা</div>
            </div>
            <div class="card">
              <div class="kpi-label">৩. PIPE FITTER JOB FEE বাবদ জমা</div>
              <div class="kpi-value purple-text" id="pipeFitterFeeVal">৳০</div>
              <div class="kpi-sub">দৈনিক Pipe Fitter Job Fee জমা</div>
            </div>
          </div>

          <div class="kpi-grid-4">
            <div class="card">
              <div class="kpi-label">মোট নগদ টাকা (পূর্বের ব্যালেন্সসহ)</div>
              <div class="kpi-value income-text" id="cardTotalCash">৳২৭৯৮২৩</div>
              <div class="kpi-sub">পূর্বের নগদ ও নতুন নগদ আয়</div>
            </div>
            <div class="card">
              <div class="kpi-label">মোট ব্যয়ের টাকা</div>
              <div class="kpi-value expense-text" id="cardTotalExpense">৳২৫১৩১০</div>
              <div class="kpi-sub">ব্যাংক জমা ও সকল খরচসহ</div>
            </div>
            <div class="card">
              <div class="kpi-label">ব্যাংকে জমা আছে</div>
              <div class="kpi-value" id="cardTotalBank">৳৭৬৭৫৭০</div>
              <div class="kpi-sub">মোট ব্যাংক স্থিতি</div>
            </div>
            <div class="card">
              <div class="kpi-label">নগদ ব্যালেন্স / (নগদ + ব্যাংক)</div>
              <div class="kpi-value" id="cardNetBalance">৳২৮৫১৩ / ৳৭৯৬০৮৩</div>
              <div class="kpi-sub">হাতে নগদ ও সর্বমোট ব্যালেন্স</div>
            </div>
          </div>

          <!-- ৩ জন কর্মকর্তার হিসাব ও আলাদা আলাদা গ্রাফ -->
          <div class="officials-grid">
            <div class="official-card">
              <div class="official-role">MANAGING DIRECTOR</div>
              <div class="official-name" style="color:var(--orange);">SABUJ KAZI</div>
              <div class="official-amount expense-text" id="mdTotalVal">৳০</div>
              <div class="graph-box" id="mdGraph"></div>
              <div class="official-form">
                <input type="number" id="mdAmtInput" placeholder="টাকা" min="1" />
                <input type="text" id="mdNoteInput" placeholder="নোট" />
                <button type="button" class="btn btn-orange" onclick="addOfficialDraw('SABUJ KAZI', 'mdAmtInput', 'mdNoteInput')">+ নিন</button>
              </div>
            </div>

            <div class="official-card">
              <div class="official-role">DIRECTOR</div>
              <div class="official-name" style="color:#60a5fa;">SOHEL KAZI</div>
              <div class="official-amount expense-text" id="dirTotalVal">৳১১১০</div>
              <div class="graph-box" id="dirGraph"></div>
              <div class="official-form">
                <input type="number" id="dirAmtInput" placeholder="টাকা" min="1" />
                <input type="text" id="dirNoteInput" placeholder="নোট" />
                <button type="button" class="btn btn-blue" onclick="addOfficialDraw('SOHEL KAZI', 'dirAmtInput', 'dirNoteInput')">+ নিন</button>
              </div>
            </div>

            <div class="official-card">
              <div class="official-role">GENERAL MANAGER</div>
              <div class="official-name" style="color:#c084fc;">SALIM MAHMMUD</div>
              <div class="official-amount expense-text" id="gmTotalVal">৳০</div>
              <div class="graph-box" id="gmGraph"></div>
              <div class="official-form">
                <input type="number" id="gmAmtInput" placeholder="টাকা" min="1" />
                <input type="text" id="gmNoteInput" placeholder="নোট" />
                <button type="button" class="btn" onclick="addOfficialDraw('SALIM MAHMMUD', 'gmAmtInput', 'gmNoteInput')">+ নিন</button>
              </div>
            </div>
          </div>

          <div class="grid-2">
            <div class="card">
              <div class="card-title">দৈনিক PP, WELDING JOB &amp; PIPE FITTER জমা সামারি</div>
              <table class="summary-table">
                <thead>
                  <tr>
                    <th>তারিখ</th>
                    <th>PP জমা</th>
                    <th>WELDING JOB FEE</th>
