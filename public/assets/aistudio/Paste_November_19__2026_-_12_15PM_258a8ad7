<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ITTC Center — Practical Test & Management System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-base: #060a12;
      --bg-sidebar: #090e18;
      --bg-surface: #0c1320;
      --bg-surface-soft: #10192b;
      --border-subtle: rgba(148, 163, 184, 0.14);
      --accent: #10b981;
      --accent-dark: #059669;
      --accent-soft: rgba(16, 185, 129, 0.14);
      --accent-glow: rgba(16, 185, 129, 0.28);
      --amber: #f59e0b;
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --font-display: 'Plus Jakarta Sans', 'Hind Siliguri', sans-serif;
      --font-body: 'Plus Jakarta Sans', 'Hind Siliguri', sans-serif;
      --font-scale: 1;
    }

    body.theme-navy {
      --accent: #eab308;
      --accent-dark: #ca8a04;
      --accent-soft: rgba(234, 179, 8, 0.15);
      --accent-glow: rgba(234, 179, 8, 0.28);
    }

    body.theme-flame {
      --accent: #f97316;
      --accent-dark: #ea580c;
      --accent-soft: rgba(249, 115, 22, 0.15);
      --accent-glow: rgba(249, 115, 22, 0.28);
    }

    body.no-animations *,
    body.no-animations *::before,
    body.no-animations *::after {
      animation: none !important;
      transition: none !important;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: calc(16px * var(--font-scale));
    }

    body {
      font-family: var(--font-body);
      background-color: var(--bg-base);
      background-image:
        radial-gradient(circle at 18% 8%, var(--accent-soft), transparent 36%),
        radial-gradient(circle at 88% 22%, rgba(59, 130, 246, 0.06), transparent 40%),
        linear-gradient(rgba(255, 255, 255, 0.014) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 36px 36px, 36px 36px;
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Keyframes */
    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes pulseDot {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 var(--accent-glow); }
      50% { transform: scale(1.2); box-shadow: 0 0 0 6px transparent; }
    }

    @keyframes ringRotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .reveal {
      opacity: 0;
      animation: fadeSlideUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* APP SHELL */
    .app-shell {
      display: grid;
      grid-template-columns: 235px 1fr;
      min-height: 100vh;
    }

    /* SIDEBAR */
    .sidebar {
      background: var(--bg-sidebar);
      border-right: 1px solid var(--border-subtle);
      padding: 14px 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 8px 12px;
      border-bottom: 1px solid var(--border-subtle);
      margin-bottom: 6px;
    }

    /* Shared Round Logo Sync */
    .synced-round-logo {
      position: relative;
      border-radius: 50%;
      background: #ffffff;
      color: #062823;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      overflow: hidden;
      border: 2px solid var(--accent);
      box-shadow: 0 0 16px var(--accent-soft);
    }

    .synced-round-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }

    .synced-round-logo .logo-fallback {
      font-family: var(--font-display);
      font-weight: 800;
      line-height: 1;
    }

    .sidebar-brand .synced-round-logo {
      width: 38px;
      height: 38px;
    }

    .sidebar-brand .logo-fallback {
      font-size: 12px;
    }

    .sidebar-brand-title {
      font-size: 13px;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.2;
    }

    .sidebar-brand-sub {
      font-size: 10.5px;
      color: var(--text-muted);
      margin-top: 1px;
    }

    .nav-label {
      font-size: 10px;
      color: var(--text-muted);
      padding: 4px 10px 2px;
      font-weight: 600;
    }

    .nav-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 11px;
      border-radius: 9px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-secondary);
      cursor: pointer;
      border: 1px solid transparent;
      background: transparent;
      width: 100%;
      text-align: left;
      font-family: inherit;
      transition: all 0.2s ease;
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, 0.04);
      color: #f1f5f9;
    }

    .nav-item.active {
      background: var(--accent);
      color: #042019;
      font-weight: 700;
    }

    .nav-item.settings-trigger {
      margin-top: 4px;
      border-color: rgba(148, 163, 184, 0.22);
      background: rgba(16, 185, 129, 0.08);
      color: #e2e8f0;
    }

    .nav-item.settings-trigger:hover {
      border-color: var(--accent);
      background: var(--accent-soft);
      color: #ffffff;
    }

    .nav-pill-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      padding: 1px 6px;
      border-radius: 6px;
      background: rgba(148, 163, 184, 0.15);
      color: #cbd5e1;
    }

    /* MAIN CONTENT */
    .main-area {
      padding: 14px 20px 32px;
    }

    /* Top utility bar */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 12px;
      margin-bottom: 14px;
      border-bottom: 1px solid var(--border-subtle);
      gap: 12px;
      flex-wrap: wrap;
    }

    .topbar-left h2 {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 800;
      color: #ffffff;
    }

    .topbar-left p {
      font-size: 11.5px;
      color: var(--text-muted);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .lang-switch {
      display: inline-flex;
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      overflow: hidden;
      background: var(--bg-surface);
    }

    .lang-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      padding: 5px 9px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }

    .lang-btn.active {
      background: rgba(255, 255, 255, 0.14);
      color: #ffffff;
    }

    .clock-box {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--text-secondary);
      text-align: right;
      line-height: 1.25;
      padding: 0 4px;
    }

    .top-action-btn {
      background: var(--bg-surface-soft);
      border: 1px solid var(--border-subtle);
      color: #f1f5f9;
      padding: 6px 12px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 11.5px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .top-action-btn:hover {
      border-color: var(--accent);
      transform: translateY(-1px);
    }

    .top-action-btn.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #042019;
      font-weight: 700;
    }

    /* HERO BANNER (Clean: no Upload/Reset buttons here) */
    .hero-banner {
      position: relative;
      background: linear-gradient(120deg, rgba(16, 185, 129, 0.18) 0%, rgba(12, 19, 32, 0.96) 55%, rgba(9, 14, 24, 0.98) 100%);
      border: 1px solid rgba(16, 185, 129, 0.32);
      border-radius: 15px;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
      overflow: hidden;
    }

    .hero-left {
      display: flex;
      align-items: center;
      gap: 16px;
      position: relative;
      z-index: 2;
    }

    .hero-logo-frame {
      position: relative;
      width: 58px;
      height: 58px;
      border-radius: 14px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .hero-logo-ring {
      position: absolute;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      border: 1.5px dashed rgba(255, 255, 255, 0.45);
      animation: ringRotate 24s linear infinite;
      pointer-events: none;
    }

    .hero-logo-frame .synced-round-logo {
      width: 40px;
      height: 40px;
      z-index: 2;
    }

    .hero-logo-frame .logo-fallback {
      font-size: 13px;
    }

    .hero-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11.5px;
      font-weight: 600;
      color: #6ee7b7;
      margin-bottom: 3px;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      animation: pulseDot 2s infinite;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.2;
    }

    .hero-subtitle {
      font-size: 12px;
      color: var(--text-secondary);
      margin-top: 2px;
    }

    .hero-buttons {
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 2;
    }

    .btn {
      border: none;
      border-radius: 9px;
      padding: 9px 15px;
      font-family: inherit;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.22s ease;
    }

    .btn:hover { transform: translateY(-2px); }

    .btn-emerald {
      background: var(--accent);
      color: #042019;
      box-shadow: 0 8px 20px -8px var(--accent-glow);
    }

    .btn-ghost {
      background: rgba(255, 255, 255, 0.05);
      color: #f1f5f9;
      border: 1px solid rgba(255, 255, 255, 0.16);
    }

    /* KPI GRID */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }

    .kpi-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 13px;
      padding: 14px 15px;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .kpi-card:hover {
      transform: translateY(-3px);
      border-color: rgba(148, 163, 184, 0.35);
    }

    .kpi-card.emerald { border-color: rgba(16, 185, 129, 0.3); }
    .kpi-card.amber { border-color: rgba(245, 158, 11, 0.38); }

    .kpi-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      font-size: 11px;
      color: var(--text-secondary);
      font-weight: 600;
    }

    .kpi-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 19px;
      font-weight: 700;
      color: #ffffff;
    }

    /* MIDDLE SECTION */
    .middle-grid {
      display: grid;
      grid-template-columns: 1.85fr 1fr;
      gap: 14px;
      margin-bottom: 16px;
    }

    .panel {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 16px 18px;
    }

    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 14px;
    }

    .panel-head h3 {
      font-family: var(--font-display);
      font-size: 14.5px;
      font-weight: 700;
      color: #ffffff;
    }

    .panel-head p {
      font-size: 11.5px;
      color: var(--text-secondary);
      margin-top: 2px;
    }

    .panel-link {
      color: var(--accent);
      font-size: 11.5px;
      font-weight: 700;
      text-decoration: none;
    }

    .cat-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .cat-chip {
      background: rgba(30, 41, 59, 0.55);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 7px 11px;
      font-size: 11px;
      font-weight: 700;
      color: #cbd5e1;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .cat-chip:hover { transform: translateY(-2px); color: #ffffff; }

    .cat-chip.active {
      background: var(--accent-soft);
      border-color: rgba(16, 185, 129, 0.5);
      color: #6ee7b7;
    }

    .cat-chip .num {
      font-family: 'JetBrains Mono', monospace;
      background: rgba(15, 23, 42, 0.8);
      padding: 1px 6px;
      border-radius: 5px;
      font-size: 10.5px;
    }

    .cat-chip.active .num {
      background: var(--accent);
      color: #042019;
      font-weight: 800;
    }

    .quick-stack {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .quick-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 13px;
      border-radius: 10px;
      border: 1px solid var(--border-subtle);
      background: rgba(15, 23, 42, 0.65);
      cursor: pointer;
      transition: all 0.22s ease;
    }

    .quick-card:hover { transform: translateX(3px); }
    .quick-card.emerald { border-color: rgba(16, 185, 129, 0.35); background: rgba(16, 185, 129, 0.08); }
    .quick-card.amber { border-color: rgba(245, 158, 11, 0.35); background: rgba(245, 158, 11, 0.08); }

    .quick-card-title { font-size: 12.5px; font-weight: 700; color: #ffffff; }
    .quick-card-sub { font-size: 11px; color: var(--text-secondary); }

    /* TABLE */
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      font-size: 10.5px;
      color: var(--text-muted);
      text-transform: uppercase;
      padding: 10px 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    td {
      padding: 11px 12px;
      font-size: 12px;
      color: #e2e8f0;
      border-bottom: 1px solid rgba(148, 163, 184, 0.07);
    }

    .mono { font-family: 'JetBrains Mono', monospace; font-weight: 700; }
    .teal { font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #2dd4bf; }

    .token-btn {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(148, 163, 184, 0.25);
      color: #f8fafc;
      padding: 5px 10px;
      border-radius: 7px;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .token-btn:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: #042019;
    }

    /* SLIDE-OVER SETTINGS DRAWER */
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 14, 0.65);
      backdrop-filter: blur(4px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
      z-index: 900;
    }

    .drawer-backdrop.open {
      opacity: 1;
      visibility: visible;
    }

    .settings-drawer {
      position: fixed;
      top: 0;
      right: 0;
      width: min(440px, 95vw);
      height: 100vh;
      background: #0b1220;
      border-left: 1px solid rgba(148, 163, 184, 0.22);
      box-shadow: -20px 0 50px rgba(0, 0, 0, 0.75);
      transform: translateX(100%);
      transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1000;
      display: flex;
      flex-direction: column;
    }

    .settings-drawer.open {
      transform: translateX(0);
    }

    .drawer-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .drawer-header h3 {
      font-size: 15px;
      font-weight: 800;
      color: #ffffff;
    }

    .drawer-header p {
      font-size: 11.5px;
      color: var(--text-secondary);
    }

    .close-drawer-btn {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-subtle);
      color: #e2e8f0;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      font-size: 16px;
      cursor: pointer;
    }

    .drawer-tabs {
      display: flex;
      gap: 6px;
      padding: 10px 16px;
      border-bottom: 1px solid var(--border-subtle);
      background: rgba(6, 10, 18, 0.5);
      overflow-x: auto;
    }

    .drawer-tab {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-secondary);
      padding: 6px 11px;
      border-radius: 8px;
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }

    .drawer-tab.active {
      background: var(--accent-soft);
      border-color: rgba(16, 185, 129, 0.4);
      color: #6ee7b7;
    }

    .drawer-body {
      padding: 18px 20px;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .tab-pane {
      display: none;
      flex-direction: column;
      gap: 14px;
    }

    .tab-pane.active {
      display: flex;
    }

    .setting-box {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 14px;
    }

    .setting-label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #e2e8f0;
      margin-bottom: 6px;
    }

    .setting-hint {
      font-size: 11px;
      color: var(--text-secondary);
      margin-bottom: 10px;
      line-height: 1.4;
    }

    .logo-preview-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 10px;
    }

    .logo-preview-row .synced-round-logo {
      width: 56px;
      height: 56px;
    }

    .form-control, select.form-control {
      width: 100%;
      background: #080d17;
      border: 1px solid rgba(148, 163, 184, 0.25);
      color: #ffffff;
      border-radius: 8px;
      padding: 8px 10px;
      font-family: inherit;
      font-size: 12px;
    }

    .range-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    input[type="range"] {
      flex: 1;
      accent-color: var(--accent);
    }

    .range-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 700;
      color: #6ee7b7;
      min-width: 46px;
      text-align: right;
    }

    .toggle-line {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 600;
      color: #e2e8f0;
      padding: 6px 0;
    }

    .drawer-footer {
      padding: 14px 20px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      gap: 10px;
      background: #080d17;
    }

    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #064e3b;
      border: 1px solid #10b981;
      color: #ecfdf5;
      padding: 10px 16px;
      border-radius: 10px;
      font-size: 12.5px;
      font-weight: 700;
      transform: translateY(80px);
      opacity: 0;
      transition: all 0.28s ease;
      z-index: 1200;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    @media (max-width: 1180px) {
      .kpi-grid { grid-template-columns: repeat(3, 1fr); }
      .middle-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 820px) {
      .app-shell { grid-template-columns: 1fr; }
      .sidebar { position: static; height: auto; }
      .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <!-- LEFT SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="synced-round-logo" data-logo-target="true">
          <img alt="ITTC Logo" />
          <span class="logo-fallback">IT</span>
        </div>
        <div>
          <div class="sidebar-brand-title" id="sidebarBrandName">ITTC Center</div>
          <div class="sidebar-brand-sub" id="sidebarBrandSub">Technical Training &amp; Testing</div>
        </div>
      </div>

