  <div class="toast" id="toastBox">Settings saved!</div>

  <script>
    const SETTINGS_KEY = 'ittc_center_settings_v1';

    const defaultSettings = {
      logoDataUrl: '',
      instituteTitle: 'WELCOME TO IDEAL TECHNICAL TRAINING & TESTING CENTER',
      instituteSub: 'Practical Test & Management System',
      fontFamily: "'Plus Jakarta Sans', 'Hind Siliguri', sans-serif",
      fontScale: 100,
      accentTheme: 'emerald',
      animationsEnabled: true,
      tokenShowLogo: true
    };

    let currentSettings = { ...defaultSettings };

    function loadSettings() {
      try {
        const raw = localStorage.getItem(SETTINGS_KEY);
        if (raw) {
          currentSettings = { ...defaultSettings, ...JSON.parse(raw) };
        }
      } catch (e) {
        console.warn('Settings load fallback:', e);
      }
    }

    function saveSettings() {
      try {
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(currentSettings));
      } catch (e) {
        console.warn('Settings save warning:', e);
      }
      showToast('Settings saved & applied!');
    }

    function showToast(msg) {
      const toast = document.getElementById('toastBox');
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2200);
    }

    // Apply all settings live to DOM
    function applySettingsToUI() {
      // 1. Sync both round logos
      document.querySelectorAll('[data-logo-target="true"]').forEach(wrap => {
        const img = wrap.querySelector('img');
        const fb = wrap.querySelector('.logo-fallback');
        if (currentSettings.logoDataUrl) {
          img.src = currentSettings.logoDataUrl;
          img.style.display = 'block';
          fb.style.display = 'none';
        } else {
          img.removeAttribute('src');
          img.style.display = 'none';
          fb.style.display = 'block';
        }
      });

      // 2. Title & Subtitle
      document.getElementById('heroInstituteTitle').textContent = currentSettings.instituteTitle;
      document.getElementById('heroInstituteSub').textContent = currentSettings.instituteSub;

      // 3. Font & Scale
      document.documentElement.style.setProperty('--font-body', currentSettings.fontFamily);
      document.documentElement.style.setProperty('--font-display', currentSettings.fontFamily);
      document.documentElement.style.setProperty('--font-scale', (currentSettings.fontScale / 100).toFixed(2));

      // 4. Theme & Animations
      document.body.classList.remove('theme-navy', 'theme-flame');
      if (currentSettings.accentTheme === 'navy') document.body.classList.add('theme-navy');
      if (currentSettings.accentTheme === 'flame') document.body.classList.add('theme-flame');
      document.body.classList.toggle('no-animations', !currentSettings.animationsEnabled);

      // Sync Drawer Inputs
      document.getElementById('inputInstituteName').value = currentSettings.instituteTitle;
      document.getElementById('inputInstituteSub').value = currentSettings.instituteSub;
      document.getElementById('fontFamilySelect').value = currentSettings.fontFamily;
      document.getElementById('fontScaleRange').value = currentSettings.fontScale;
      document.getElementById('fontScaleBadge').textContent = `${currentSettings.fontScale}%`;
      document.getElementById('accentThemeSelect').value = currentSettings.accentTheme;
      document.getElementById('motionToggle').checked = currentSettings.animationsEnabled;
      document.getElementById('tokenLogoToggle').checked = currentSettings.tokenShowLogo;
    }

    // Drawer Open / Close
    const drawer = document.getElementById('settingsDrawer');
    const backdrop = document.getElementById('drawerBackdrop');

    function openDrawer() {
      drawer.classList.add('open');
      backdrop.classList.add('open');
    }

    function closeDrawer() {
      drawer.classList.remove('open');
      backdrop.classList.remove('open');
    }

    document.getElementById('openSettingsBtn').addEventListener('click', openDrawer);
    document.getElementById('closeSettingsBtn').addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    // Drawer Tabs
    document.querySelectorAll('.drawer-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.drawer-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(`tab-${tab.dataset.tab}`).classList.add('active');
      });
    });

    // Logo Upload & Reset inside Drawer
    const drawerLogoInput = document.getElementById('drawerLogoInput');
    document.getElementById('drawerUploadBtn').addEventListener('click', () => drawerLogoInput.click());

    drawerLogoInput.addEventListener('change', e => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        currentSettings.logoDataUrl = reader.result;
        applySettingsToUI();
        saveSettings();
      };
      reader.readAsDataURL(file);
      drawerLogoInput.value = '';
    });

    document.getElementById('drawerResetLogoBtn').addEventListener('click', () => {
      currentSettings.logoDataUrl = '';
      applySettingsToUI();
      saveSettings();
    });

    // Live inputs
    document.getElementById('inputInstituteName').addEventListener('input', e => {
      currentSettings.instituteTitle = e.target.value;
      applySettingsToUI();
    });

    document.getElementById('inputInstituteSub').addEventListener('input', e => {
      currentSettings.instituteSub = e.target.value;
      applySettingsToUI();
    });

    document.getElementById('fontFamilySelect').addEventListener('change', e => {
      currentSettings.fontFamily = e.target.value;
      applySettingsToUI();
    });

    document.getElementById('fontScaleRange').addEventListener('input', e => {
      currentSettings.fontScale = Number(e.target.value);
      applySettingsToUI();
    });

    document.getElementById('accentThemeSelect').addEventListener('change', e => {
      currentSettings.accentTheme = e.target.value;
      applySettingsToUI();
    });

    document.getElementById('motionToggle').addEventListener('change', e => {
      currentSettings.animationsEnabled = e.target.checked;
      applySettingsToUI();
    });

    document.getElementById('tokenLogoToggle').addEventListener('change', e => {
      currentSettings.tokenShowLogo = e.target.checked;
    });

    document.getElementById('saveSettingsBtn').addEventListener('click', saveSettings);

    document.getElementById('resetAllSettingsBtn').addEventListener('click', () => {
      currentSettings = { ...defaultSettings };
      applySettingsToUI();
      saveSettings();
    });

    // KPI Count-up
    document.querySelectorAll('.kpi-val[data-target]').forEach(el => {
      const target = Number(el.dataset.target) || 0;
      const prefix = el.dataset.prefix || '';
      const duration = 950;
      const start = performance.now();
      function step(now) {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = prefix + Math.round(target * eased).toLocaleString('en-IN');
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });

    // Live Clock
    function tickClock() {
      const now = new Date();
      document.getElementById('liveClock').textContent = now.toLocaleTimeString('en-US', { hour12: true });
    }
    setInterval(tickClock, 1000);
    tickClock();

    // New Tab Token Print (3in x 3.5in on A4, 0.3in top margin, all black, no payment)
    function printToken(job) {
      const win = window.open('', '_blank');
      if (!win) {
        alert('Please allow pop-ups to print token.');
        return;
      }

      const logoBlock = currentSettings.tokenShowLogo
        ? `<div class="mini-round-seal">
             ${currentSettings.logoDataUrl
               ? `<img src="${currentSettings.logoDataUrl}" style="width:34px;height:34px;border-radius:50%;object-fit:cover;margin-bottom:2px;" />`
               : `<div class="seal-cap">✓</div>`}
             <div class="seal-title">IDEAL TECHNICAL<br>TRAINING &amp; TESTING CENTER</div>
             <div class="seal-sub">ID: ${job.jobNumber} | CODE: ${job.studentCode}</div>
           </div>`
        : '';

      win.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="UTF-8">
          <title>Token ${job.jobNumber}</title>
          <style>
            @page { size: A4 portrait; margin: 0.3in 0 0 0; }
            * { box-sizing: border-box; margin: 0; padding: 0; color: #000000; }
            body { width: 100%; background: #ffffff; font-family: 'Hind Siliguri', 'Plus Jakarta Sans', sans-serif; }
            .wrap { width: 100%; display: flex; justify-content: center; padding-top: 0.3in; }
            .card {
              width: 3in; height: 3.5in; border: 2px solid #000000; border-radius: 10px;
              padding: 8px 10px; text-align: center; display: flex; flex-direction: column;
              justify-content: space-between; background: #ffffff;
            }
            .inst { font-size: 9.5px; font-weight: 800; line-height: 1.15; }
            .badge { display: inline-block; background: #000000; color: #ffffff; font-size: 8.8px; font-weight: 700; padding: 2.5px 12px; border-radius: 4px; margin: 4px 0; }
            .grid { display: grid; grid-template-columns: 1fr 1fr; border: 1.5px solid #000000; border-radius: 6px; margin-bottom: 4px; }
            .cell { padding: 4px; }
            .cell:first-child { border-right: 1.5px solid #000000; }
            .lbl { font-size: 7px; font-weight: 700; }
            .val { font-size: 11px; font-weight: 700; font-family: 'JetBrains Mono', monospace; }
            .row { display: flex; justify-content: space-between; font-size: 10px; padding: 2.5px 0; border-bottom: 1px dotted #000000; }
            .row:last-child { border-bottom: none; }
            .seal-wrap { display: flex; justify-content: center; align-items: center; }
            .mini-round-seal {
              width: 116px; height: 116px; border-radius: 50%; border: 2.5px solid #000000;
              display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 6px;
            }
            .seal-cap { font-size: 14px; font-weight: 900; line-height: 1; margin-bottom: 2px; }
            .seal-title { font-size: 5px; font-weight: 800; line-height: 1.15; }
