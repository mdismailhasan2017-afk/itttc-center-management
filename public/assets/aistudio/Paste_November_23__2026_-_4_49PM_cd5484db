      const uniqueDates = [...new Set([d, ...state.rows.map(r => r.date)])].sort();
      const pillBox = document.getElementById('datePillGroup');
      pillBox.innerHTML = '';
      uniqueDates.forEach(dtStr => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'date-pill' + (dtStr === d ? ' active' : '');
        b.textContent = toBn(dtStr);
        b.onclick = () => changeActiveDate(dtStr);
        pillBox.appendChild(b);
      });

      renderDashboardAnalytics(sum, uniqueDates);
      renderSheet();
    }

    function renderDashboardAnalytics(sum, uniqueDates) {
      let weldingTotal = 0, fitterTotal = 0, visaTotal = 0, ppeTotal = 0;
      let mdTotal = 0, dirTotal = 0, gmTotal = 0;
      const mdItems = [], dirItems = [], gmItems = [];
      const catMap = {};

      sum.dayRows.forEach(r => {
        const incText = (r.incSrc || '').toLowerCase();
        const incVal = (Number(r.incCash) || 0) + (Number(r.incBank) || 0);
        if (incText.includes('welding')) weldingTotal += incVal;
        if (incText.includes('fitter')) fitterTotal += incVal;
        if (incText.includes('visa')) visaTotal += incVal;
        if (incText.includes('p.p.e') || incText.includes('ppe')) ppeTotal += incVal;

        const expText = (r.expSrc || '').trim();
        const expVal = Number(r.expAmt) || 0;
        if (expVal > 0 && expText) {
          catMap[expText] = (catMap[expText] || 0) + expVal;
          const up = expText.toUpperCase();
          if (up.includes('SABUJ')) {
            mdTotal += expVal;
            mdItems.push({ label: expText.replace(/SABUJ KAZI/i, '').trim() || 'খরচ', val: expVal });
          } else if (up.includes('SOHEL')) {
            dirTotal += expVal;
            dirItems.push({ label: expText.replace(/SOHEL KAZI/i, '').trim() || 'খরচ', val: expVal });
          } else if (up.includes('SALIM')) {
            gmTotal += expVal;
            gmItems.push({ label: expText.replace(/SALIM MAHMMUD/i, '').trim() || 'খরচ', val: expVal });
          }
        }
      });

      document.getElementById('weldingJobFeeVal').textContent = `৳${toBn(weldingTotal)}`;
      document.getElementById('fitterFeeVal').textContent = `৳${toBn(fitterTotal)}`;
      document.getElementById('visaFeeVal').textContent = `৳${toBn(visaTotal)}`;
      document.getElementById('ppeFeeVal').textContent = `৳${toBn(ppeTotal)}`;

      document.getElementById('mdTotalVal').textContent = `৳${toBn(mdTotal)}`;
      document.getElementById('dirTotalVal').textContent = `৳${toBn(dirTotal)}`;
      document.getElementById('gmTotalVal').textContent = `৳${toBn(gmTotal)}`;

      renderMiniGraph('mdGraph', mdItems, 'var(--orange)');
      renderMiniGraph('dirGraph', dirItems, '#60a5fa');
      renderMiniGraph('gmGraph', gmItems, '#c084fc');

      const barContainer = document.getElementById('expenseCategoryBars');
      const entries = Object.entries(catMap).sort((a, b) => b[1] - a[1]).slice(0, 6);
      const maxCat = entries.length ? entries[0][1] : 1;
      barContainer.innerHTML = entries.length ? entries.map(([k, v]) => `
        <div class="h-bar-item">
          <span class="h-bar-label" title="${k}">${k}</span>
          <div class="h-bar-track"><div class="h-bar-fill" style="width:${Math.round((v / maxCat) * 100)}%"></div></div>
          <strong>৳${toBn(v)}</strong>
        </div>
      `).join('') : '<div style="font-size:12px;color:var(--muted);">এই তারিখে কোনো ব্যয় নেই।</div>';

      const sumBody = document.getElementById('dailyCategorySummaryBody');
      sumBody.innerHTML = uniqueDates.map(dt => {
        const rows = state.rows.filter(r => r.date === dt);
        let w = 0, f = 0, vFee = 0, ppe = 0;
        rows.forEach(r => {
          const t = (r.incSrc || '').toLowerCase();
          const v = (Number(r.incCash) || 0) + (Number(r.incBank) || 0);
          if (t.includes('welding')) w += v;
          if (t.includes('fitter')) f += v;
          if (t.includes('visa')) vFee += v;
          if (t.includes('p.p.e') || t.includes('ppe')) ppe += v;
        });
        return `<tr><td>${toBn(dt)}</td><td>৳${toBn(w)}</td><td>৳${toBn(f)}</td><td>৳${toBn(vFee)}</td><td>৳${toBn(ppe)}</td></tr>`;
      }).join('');
    }

    function renderMiniGraph(elId, items, color) {
      const box = document.getElementById(elId);
      if (!items.length) {
        box.innerHTML = `<div style="width:100%;text-align:center;font-size:11px;color:var(--muted);align-self:center;">কোনো এন্ট্রি নেই</div>`;
        return;
      }
      const max = Math.max(...items.map(i => i.val), 1);
      box.innerHTML = items.map(i => `
        <div class="bar-col">
          <span class="bar-val">৳${toBn(i.val)}</span>
          <div class="bar-fill" style="height:${Math.max(12, Math.round((i.val / max) * 110))}px;background:${color};"></div>
          <span class="bar-lbl" title="${i.label}">${i.label}</span>
        </div>
      `).join('');
    }

