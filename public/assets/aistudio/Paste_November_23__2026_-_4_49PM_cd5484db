  <script>
    const STORAGE_KEY = 'ittc_general_accounts_purpose_v2';
    const PASS_CODE = '1234';
    const banglaDays = ['রবিবার', 'সোমবার', 'মঙ্গলবার', 'বুধবার', 'বৃহস্পতিবার', 'শুক্রবার', 'শনিবার'];
    const banglaDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];

    let entryMode = 'expense'; // 'income' | 'expense' | 'bank'

    function toBn(val) {
      return String(val).replace(/\d/g, d => banglaDigits[d]);
    }

    function parseDotDate(dotStr) {
      const parts = (dotStr || '').trim().split('.');
      if (parts.length !== 3) return null;
      const d = parseInt(parts[0], 10);
      const m = parseInt(parts[1], 10) - 1;
      const y = parseInt(parts[2], 10);
      const dt = new Date(y, m, d);
      return isNaN(dt.getTime()) ? null : dt;
    }

    function formatDotDate(dt) {
      const d = String(dt.getDate()).padStart(2, '0');
      const m = String(dt.getMonth() + 1).padStart(2, '0');
      const y = dt.getFullYear();
      return `${d}.${m}.${y}`;
    }

    function getDayNameFromDot(dotStr) {
      const dt = parseDotDate(dotStr);
      return dt ? banglaDays[dt.getDay()] : 'রবিবার';
    }

    function getPrevDotDate(dotStr) {
      const dt = parseDotDate(dotStr);
      if (!dt) return '21.11.2026';
      dt.setDate(dt.getDate() - 1);
      return formatDotDate(dt);
    }

    function getNextVoucherSuggestion() {
      let maxNum = 4598;
      state.rows.forEach(r => {
        const m = (r.voucher || '').match(/(\d+)$/);
        if (m) {
          const n = parseInt(m[1], 10);
          if (n > maxNum) maxNum = n;
        }
      });
      return `ME.NO-${maxNum + 1}`;
    }

    function defaultState() {
      return {
        activeDate: '22.11.2026',
        lockedDates: {},
        manualOpenings: {
          '22.11.2026': { prevDate: '21.11.2026', cash: 215423, bank: 543570, bkash: 0 }
        },
        rows: [
          { id: 'r1', date: '22.11.2026', voucher: 'ME.NO-4582', account: 'Cash', incSrc: 'For The Purpose Of Welding Job Fee', incCash: 10000, incBank: 0, expSrc: '', expAmt: 0 },
          { id: 'r2', date: '22.11.2026', voucher: 'ME.NO-4583', account: 'Cash', incSrc: 'For The Purpose Of P.P.E', incCash: 4000, incBank: 0, expSrc: 'SABUJ KAZI আপ্যায়ন খরচ', expAmt: 100 },
          { id: 'r3', date: '22.11.2026', voucher: 'ME.NO-4584', account: 'Cash', incSrc: 'For The Purpose Of Fitter Fee', incCash: 11400, incBank: 0, expSrc: 'SOHEL KAZI সার্টিফিকেট প্রিন্টিং খরচ', expAmt: 5400 },
          { id: 'r4', date: '22.11.2026', voucher: 'ME.NO-4585', account: 'Cash', incSrc: 'For The Purpose Of Visa Fee', incCash: 10000, incBank: 0, expSrc: 'SALIM MAHMMUD যাতায়াত ভাড়া', expAmt: 200 },
          { id: 'r5', date: '22.11.2026', voucher: 'ME.NO-4586', account: 'Bkash', incSrc: 'For The Purpose Of Welding Job Fee', incCash: 0, incBank: 15000, expSrc: 'অফিস স্টেশনারি খরচ', expAmt: 1110 },
          { id: 'r6', date: '22.11.2026', voucher: 'ME.NO-4587', account: 'Bank', incSrc: 'For The Purpose Of Visa Fee', incCash: 10000, incBank: 224000, expSrc: 'ব্যাংকে জমা', expAmt: 224000 }
        ]
      };
    }

    let state = defaultState();

    function loadState() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        try {
          const parsed = JSON.parse(raw);
          if (parsed && Array.isArray(parsed.rows)) {
            state = parsed;
          }
        } catch (e) { console.error(e); }
      }
      document.getElementById('txVoucher').value = getNextVoucherSuggestion();
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    // Password Lock
    document.getElementById('unlockForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const val = document.getElementById('passwordInput').value.trim();
      if (val === PASS_CODE) {
        document.getElementById('lockScreen').style.display = 'none';
        document.getElementById('appShell').classList.add('unlocked');
        renderAll();
      } else {
        document.getElementById('lockError').textContent = 'ভুল পাসওয়ার্ড! ডিফল্ট পাসওয়ার্ড: 1234';
      }
    });

    document.getElementById('lockBtn').addEventListener('click', function() {
      document.getElementById('appShell').classList.remove('unlocked');
      document.getElementById('lockScreen').style.display = 'flex';
      document.getElementById('passwordInput').value = '';
      document.getElementById('lockError').textContent = '';
    });

    // Sidebar Navigation
    function switchPane(paneId) {
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
      document.getElementById(paneId).classList.add('active');
      document.querySelectorAll('.nav-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.pane === paneId);
      });
      renderAll();
    }

    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => switchPane(btn.dataset.pane));
    });

    // Balance & Carry-forward Engine
    function getDaySummary(dotDate) {
      const opening = getOpening(dotDate);
      const dayRows = state.rows.filter(r => r.date === dotDate);
      let newCashIn = 0;
      let newBankBkashIn = 0;
      let totalExp = 0;

      dayRows.forEach(r => {
        newCashIn += Number(r.incCash) || 0;
        newBankBkashIn += Number(r.incBank) || 0;
        totalExp += Number(r.expAmt) || 0;
      });

      const openCash = Number(opening.cash) || 0;
      const openBankBkash = (Number(opening.bank) || 0) + (Number(opening.bkash) || 0);

      const totalCash = openCash + newCashIn;
      const totalBank = openBankBkash + newBankBkashIn;
      const cashBalance = totalCash - totalExp;
      const grandTotal = cashBalance + totalBank;

      return { opening, dayRows, newCashIn, newBankBkashIn, totalCash, totalBank, totalExp, cashBalance, grandTotal };
    }

    function getOpening(dotDate) {
      if (state.manualOpenings && state.manualOpenings[dotDate]) {
        return state.manualOpenings[dotDate];
      }
      const prevStr = getPrevDotDate(dotDate);
      const hasPrev = state.rows.some(r => r.date === prevStr) || (state.manualOpenings && state.manualOpenings[prevStr]);
      if (hasPrev) {
        const prevSum = getDaySummary(prevStr);
        return { prevDate: prevStr, cash: prevSum.cashBalance, bank: prevSum.totalBank, bkash: 0 };
      }
      return { prevDate: prevStr, cash: 0, bank: 0, bkash: 0 };
    }

    // Mode Switching
    function setEntryMode(mode) {
      entryMode = mode;
      const incBtn = document.getElementById('modeIncomeBtn');
      const expBtn = document.getElementById('modeExpenseBtn');
      const bnkBtn = document.getElementById('modeBankBtn');
      const descLbl = document.getElementById('txDescLabel');
      const subBtn = document.getElementById('txSubmitBtn');

      incBtn.className = 'mode-btn';
      expBtn.className = 'mode-btn';
      bnkBtn.className = 'mode-btn';

      if (mode === 'income') {
        incBtn.classList.add('active-income');
        descLbl.textContent = 'Income Description';
        subBtn.className = 'btn';
      } else if (mode === 'expense') {
        expBtn.classList.add('active-expense');
        descLbl.textContent = 'Expense Description';
        subBtn.className = 'btn btn-red';
      } else {
        bnkBtn.classList.add('active-bank');
        descLbl.textContent = 'Bank / Bkash Transfer Note';
        subBtn.className = 'btn btn-blue';
      }
    }

    document.getElementById('modeIncomeBtn').addEventListener('click', () => setEntryMode('income'));
    document.getElementById('modeExpenseBtn').addEventListener('click', () => setEntryMode('expense'));
    document.getElementById('modeBankBtn').addEventListener('click', () => setEntryMode('bank'));

    function onPurposeSelectChange() {
      const p = document.getElementById('txPurpose').value;
      if (p && p !== 'অন্যান্য') {
        document.getElementById('txDesc').value = `For The Purpose Of ${p}`;
        setEntryMode('income');
      }
    }

    function applyPurpose(text, mode) {
      const purposeList = ['Welding Job Fee', 'Fitter Fee', 'Visa Fee', 'P.P.E'];
      if (purposeList.includes(text)) {
        document.getElementById('txPurpose').value = text;
        document.getElementById('txDesc').value = `For The Purpose Of ${text}`;
      } else {
        document.getElementById('txDesc').value = text;
      }
      setEntryMode(mode);
      document.getElementById('txAmount').focus();
    }

    // Date Controls
    function changeActiveDate(newDotDate) {
      state.activeDate = newDotDate;
      saveState();
      renderAll();
    }

    document.getElementById('prevDateBtn').addEventListener('click', () => {
      const dt = parseDotDate(state.activeDate);
      if (!dt) return;
      dt.setDate(dt.getDate() - 1);
      changeActiveDate(formatDotDate(dt));
    });

    document.getElementById('nextDateBtn').addEventListener('click', () => {
      const dt = parseDotDate(state.activeDate);
      if (!dt) return;
      dt.setDate(dt.getDate() + 1);
      changeActiveDate(formatDotDate(dt));
    });

    document.getElementById('activeTxDate').addEventListener('change', function() {
      const dt = parseDotDate(this.value);
      if (dt) changeActiveDate(formatDotDate(dt));
    });

    document.getElementById('saveOpeningBtn').addEventListener('click', function() {
      const d = state.activeDate;
      state.manualOpenings[d] = {
        prevDate: document.getElementById('openingDateInput').value.trim() || getPrevDotDate(d),
        cash: parseFloat(document.getElementById('openingCashInput').value) || 0,
        bank: parseFloat(document.getElementById('openingBankInput').value) || 0,
        bkash: parseFloat(document.getElementById('openingBkashInput').value) || 0
      };
      saveState();
      renderAll();
      alert('পূর্বের ব্যালেন্স সংরক্ষিত হয়েছে।');
    });

    document.getElementById('lockDayBtn').addEventListener('click', function() {
      const d = state.activeDate;
      state.lockedDates[d] = !state.lockedDates[d];
      saveState();
      renderAll();
    });

    // Quick Transaction Submit
    document.getElementById('quickTxForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const d = state.activeDate;
      if (state.lockedDates[d]) {
        alert('এই দিনটি লক করা আছে। আনলক করে এন্ট্রি দিন।');
        return;
      }

      const acc = document.getElementById('txAccount').value; // Cash | Bank | Bkash
      const voucher = document.getElementById('txVoucher').value.trim() || 'ME.NO-4599';
      const purpose = document.getElementById('txPurpose').value;
      let desc = document.getElementById('txDesc').value.trim();
      if (purpose && purpose !== 'অন্যান্য' && !desc.toLowerCase().includes(purpose.toLowerCase())) {
        desc = `For The Purpose Of ${purpose} (${desc})`;
      }
      const amt = parseFloat(document.getElementById('txAmount').value) || 0;
      if (!desc || amt <= 0) return;

      const row = {
        id: 'row_' + Date.now(),
        date: d,
        voucher,
        account: acc,
        incSrc: '',
        incCash: 0,
        incBank: 0,
        expSrc: '',
        expAmt: 0
      };

      if (entryMode === 'income') {
        row.incSrc = desc;
        if (acc === 'Cash') row.incCash = amt;
        else row.incBank = amt; // Bank or Bkash
      } else if (entryMode === 'expense') {
        row.expSrc = `[${acc}] ${desc}`;
        row.expAmt = amt;
      } else {
        // Bank / Bkash transfer
        if (acc === 'Bank' || acc === 'Bkash') {
          row.incSrc = `${acc} ডিপোজিট: ${desc}`;
          row.incBank = amt;
          row.expSrc = `${acc} ডিপোজিট`;
          row.expAmt = amt;
        } else {
          row.incSrc = `উত্তোলন: ${desc}`;
          row.incCash = amt;
        }
      }

      state.rows.push(row);
      saveState();
      document.getElementById('txDesc').value = '';
      document.getElementById('txAmount').value = '';
      document.getElementById('txPurpose').value = '';
      document.getElementById('txVoucher').value = getNextVoucherSuggestion();
      renderAll();
    });

    document.getElementById('addBlankRowBtn').addEventListener('click', function() {
      if (state.lockedDates[state.activeDate]) return;
      state.rows.push({
        id: 'row_' + Date.now(),
        date: state.activeDate,
        voucher: '',
        account: 'Cash',
        incSrc: '', incCash: 0, incBank: 0, expSrc: '', expAmt: 0
      });
      saveState();
      renderAll();
    });

    document.getElementById('resetSampleBtn').addEventListener('click', function() {
      if (!confirm('নমুনা ডেটায় ফিরে যেতে চান?')) return;
      state = defaultState();
      saveState();
      document.getElementById('txVoucher').value = getNextVoucherSuggestion();
      renderAll();
    });

    document.getElementById('searchInput').addEventListener('input', renderSheet);
    document.getElementById('filterMode').addEventListener('change', renderSheet);

    function deleteRow(id) {
      if (state.lockedDates[state.activeDate]) {
        alert('দিনটি লক করা আছে।');
        return;
      }
      state.rows = state.rows.filter(r => r.id !== id);
      saveState();
      renderAll();
    }

    function printSingleReceipt(id) {
      const r = state.rows.find(x => x.id === id);
      if (!r) return;
      const amt = r.incCash || r.incBank || r.expAmt || 0;
      const title = r.incSrc || r.expSrc || 'সাধারণ হিসাব';
