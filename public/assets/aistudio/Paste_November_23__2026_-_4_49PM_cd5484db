        <html><head><title>Money Receipt</title>
        <style>body{font-family:"SolaimanLipi",sans-serif;padding:24px;} .card{border:2px solid #000;padding:18px;border-radius:6px;} h3{text-align:center;margin-bottom:6px;} .row{display:flex;justify-content:space-between;margin:8px 0;border-bottom:1px dashed #999;padding-bottom:4px;}</style>
        </head><body><div class="card"><h3>আইডিয়াল টেকনিক্যাল ট্রেনিং এন্ড টেস্টিং সেন্টার</h3><div style="text-align:center;font-size:12px;margin-bottom:14px;">মানি রিসিট / ক্যাশ ভাউচার</div>
        <div class="row"><span>ভাউচার নং:</span><strong>${r.voucher || 'N/A'}</strong></div>
        <div class="row"><span>তারিখ:</span><strong>${r.date}</strong></div>
        <div class="row"><span>অ্যাকাউন্ট:</span><strong>${r.account || 'Cash'}</strong></div>
        <div class="row"><span>বিবরণ:</span><strong>${title}</strong></div>
        <div class="row"><span>পরিমাণ:</span><strong>৳ ${amt.toLocaleString('en-US')}</strong></div>
        <div style="margin-top:38px;display:flex;justify-content:space-between;font-size:12px;"><span>গ্রহীতার স্বাক্ষর</span><span>কর্তৃপক্ষের স্বাক্ষর</span></div>
        </div></body></html>
      `);
      w.document.close();
      w.focus();
      setTimeout(() => { w.print(); w.close(); }, 250);
    }

    function fmtCell(n) {
      return n && Number(n) !== 0 ? Number(n).toLocaleString('en-US') : '';
    }

