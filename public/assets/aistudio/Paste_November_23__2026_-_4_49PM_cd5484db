            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });

      const minRows = 16;
      const blanks = Math.max(0, minRows - filteredRows.length);
      for (let i = 0; i < blanks; i++) {
        const trB = document.createElement('tr');
        trB.innerHTML = `
          <td class="text-center">${i < 4 ? d : ''}</td>
          <td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td>
          <td class="no-print"></td>
        `;
        tbody.appendChild(trB);
      }

      const tfoot = document.getElementById('ledgerFooter');
      tfoot.innerHTML = `
        <tr>
          <td></td>
          <td class="bold">ব্যাংকে/বিকাশে জমা আছে=</td>
          <td></td>
          <td></td>
          <td class="text-right bold">ব্যাংকে/বিকাশে জমা আছে=</td>
          <td></td><td></td><td></td><td></td><td></td><td></td>
          <td class="no-print"></td>
        </tr>
        <tr>
          <td></td>
          <td></td>
          <td class="text-right bg-green">${sum.totalCash.toLocaleString('en-US')}</td>
          <td class="text-right bg-green">${sum.totalBank.toLocaleString('en-US')}</td>
          <td class="text-right bold">ক্যাশে জমা আছে=</td>
