<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GENERAL ACCOUNTS - ITTC Center</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "SolaimanLipi", "Nikosh", "Segoe UI", Tahoma, sans-serif;
    }

    :root {
      --bg: #040d0c;
      --sidebar: #071412;
      --panel: #091b18;
      --card: #0a1f1c;
      --border: #17493d;
      --accent: #10b981;
      --accent-soft: rgba(16, 185, 129, 0.16);
      --pink: #ec4899;
      --blue: #3b82f6;
      --purple: #8b5cf6;
      --orange: #f97316;
      --red: #dc2626;
      --text: #f1f5f9;
      --muted: #8ea8a1;
    }

    body {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* Password Lock Screen */
    .lock-screen {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: radial-gradient(circle at top, #0d2e28 0%, #040d0c 70%);
    }

    .lock-card {
      width: 100%;
      max-width: 390px;
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .lock-badge {
      display: inline-block;
      width: fit-content;
      background: var(--accent-soft);
      color: var(--accent);
      border: 1px solid rgba(16, 185, 129, 0.4);
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    .lock-card h1 { font-size: 18px; }
    .lock-card p { font-size: 12px; color: var(--muted); line-height: 1.5; }

    .lock-input {
      width: 100%;
      background: var(--panel);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 14px;
      outline: none;
    }

    .lock-input:focus { border-color: var(--accent); }
    .lock-error { color: #f87171; font-size: 12px; min-height: 16px; }

    /* App Shell */
    .app-shell { display: none; min-height: 100vh; }
    .app-shell.unlocked { display: grid; grid-template-columns: 225px 1fr; }

    .sidebar {
      background: var(--sidebar);
      border-right: 1.5px solid var(--border);
      padding: 14px 10px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
    }

    .brand-box {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 8px 12px 8px;
      border-bottom: 1px solid var(--border);
    }

    .brand-logo {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 12px;
    }

    .brand-title { font-size: 13px; font-weight: 700; }
    .brand-sub { font-size: 10.5px; color: var(--muted); }

    .nav-list { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }

    .nav-btn {
      width: 100%;
      text-align: left;
      background: transparent;
      color: var(--muted);
      border: 1px solid transparent;
      border-radius: 8px;
      padding: 9px 11px;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
    }

    .nav-btn:hover { background: var(--panel); color: var(--text); }
    .nav-btn.active { background: var(--accent); color: #04100c; font-weight: 700; }

    .main-content { display: flex; flex-direction: column; min-width: 0; }

    .topbar {
      background: var(--sidebar);
      border-bottom: 1.5px solid var(--border);
      padding: 10px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .topbar-left h2 { font-size: 15px; font-weight: 700; }
    .topbar-left span { font-size: 11px; color: var(--muted); }
    .topbar-right { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

    .btn {
      background: var(--accent);
      color: #04100c;
      border: none;
      border-radius: 6px;
      padding: 7px 12px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-pink { background: var(--pink); color: #ffffff; }
    .btn-blue { background: #2563eb; color: #ffffff; }
    .btn-red { background: var(--red); color: #ffffff; }
    .btn-secondary { background: var(--panel); color: var(--text); border: 1px solid var(--border); }

    .page-body {
      padding: 14px 18px 24px 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .tab-pane { display: none; flex-direction: column; gap: 12px; }
    .tab-pane.active { display: flex; }

    /* Dashboard Styles */
    .top-strip {
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      padding: 12px 16px;
      display: grid;
      grid-template-columns: repeat(4, 1fr) 230px;
      gap: 14px;
      align-items: center;
    }

    .strip-kpi {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 2px;
      border-right: 1px solid rgba(23, 73, 61, 0.7);
      padding-right: 8px;
    }

    .strip-label { font-size: 11px; color: var(--muted); font-weight: 600; }
    .strip-val { font-size: 17px; font-weight: 700; }
    .strip-sub { font-size: 10.5px; color: var(--muted); }

    .date-box { display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .date-box-title { font-size: 11.5px; font-weight: 700; color: var(--text); }
    .date-pill-group { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }

    .date-pill {
      background: var(--panel);
      color: var(--muted);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }

    .date-pill.active { background: var(--accent); color: #04100c; border-color: var(--accent); }

    .opening-bar {
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      padding: 11px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .opening-title { font-size: 12.5px; font-weight: 700; color: var(--accent); }
    .opening-inputs { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

    .opening-field {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--muted);
    }

    .opening-field input {
      width: 110px;
      background: var(--panel);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 6px;
      padding: 5px 8px;
      font-size: 12px;
      font-weight: 700;
      outline: none;
    }

    .bi-card {
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      padding: 13px 15px;
    }

    .bi-title {
      text-align: center;
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 10px;
    }

    .kpi-grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .kpi-label { font-size: 11px; color: var(--muted); margin-bottom: 4px; }
    .kpi-value { font-size: 19px; font-weight: 700; }
    .kpi-sub { font-size: 11px; color: var(--muted); margin-top: 3px; }

    .income-text { color: #34d399; }
    .expense-text { color: #f472b6; }
    .blue-text { color: #60a5fa; }
    .purple-text { color: #a78bfa; }
    .orange-text { color: #fb923c; }

    .officials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }

    .official-card {
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      padding: 14px 15px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .official-role { font-size: 10.5px; font-weight: 700; color: var(--muted); text-align: center; }
    .official-name { font-size: 14.5px; font-weight: 700; text-align: center; }
    .official-amount { font-size: 21px; font-weight: 700; text-align: center; }

    .graph-box {
      background: var(--panel);
      border: 1px solid rgba(23, 73, 61, 0.8);
      border-radius: 8px;
      padding: 12px 10px 8px 10px;
      height: 165px;
      display: flex;
      align-items: flex-end;
      gap: 8px;
    }

    .bar-col { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 4px; }
    .bar-fill { width: 100%; max-width: 34px; border-radius: 4px 4px 0 0; min-height: 4px; }
    .bar-val { font-size: 10px; font-weight: 700; }
    .bar-lbl { font-size: 9.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .h-bar-list { display: flex; flex-direction: column; gap: 8px; }
    .h-bar-item { display: grid; grid-template-columns: 145px 1fr auto; gap: 8px; align-items: center; font-size: 11.5px; }
    .h-bar-label { color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .h-bar-track { height: 14px; background: var(--panel); border-radius: 3px; overflow: hidden; }
    .h-bar-fill { height: 100%; background: var(--pink); }

    .summary-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .summary-table th, .summary-table td { padding: 8px 8px; border-bottom: 1px solid rgba(23, 73, 61, 0.65); text-align: left; }
    .summary-table th { color: var(--muted); font-size: 11px; }

    /* Transaction Entry Panel */
    .tx-kpi-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .tx-kpi-card {
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      padding: 12px 15px;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .tx-kpi-title { font-size: 11px; color: var(--muted); font-weight: 600; }
    .tx-kpi-main { font-size: 19px; font-weight: 700; }
    .tx-kpi-sub { font-size: 10.5px; color: var(--muted); }

    .entry-box {
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      padding: 13px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .entry-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(23, 73, 61, 0.7);
    }

    .date-stepper {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .step-btn {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 9px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .date-input-inline {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 10px;
      font-size: 12px;
      font-weight: 700;
      width: 115px;
      outline: none;
    }

    .mode-switch-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .mode-btns { display: flex; gap: 8px; flex-wrap: wrap; }

    .mode-btn {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .mode-btn.active-income { background: #16a34a; color: #ffffff; border-color: #16a34a; }
    .mode-btn.active-expense { background: #dc2626; color: #ffffff; border-color: #dc2626; }
    .mode-btn.active-bank { background: #2563eb; color: #ffffff; border-color: #2563eb; }

    .quick-select-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      font-size: 11px;
      color: var(--muted);
    }

    .preset-chip {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 4px 9px;
      font-size: 11px;
      cursor: pointer;
    }

    .preset-chip:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .entry-inputs-grid {
      display: grid;
      grid-template-columns: 125px 150px 180px 1fr 130px auto;
      gap: 10px;
      align-items: end;
    }

    .e-field { display: flex; flex-direction: column; gap: 4px; }
    .e-field label { font-size: 11px; color: var(--muted); font-weight: 600; }

    .e-field input,
    .e-field select {
      background: var(--panel);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 7px;
      padding: 8px 10px;
      font-size: 12.5px;
      outline: none;
    }

    .e-field input:focus,
    .e-field select:focus { border-color: var(--accent); }

    .sheet-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 8px;
    }

    .filter-group { display: flex; gap: 8px; flex-wrap: wrap; }

    .filter-group input,
    .filter-group select {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 12px;
      outline: none;
    }

    /* Reference Image Sheet Style */
    .excel-container {
      background: #ffffff;
      color: #000000;
      border: 2px solid #1d4ed8;
      padding: 6px;
      overflow-x: auto;
      border-radius: 4px;
    }

    .sheet-banner-green {
      background: #00b050;
      color: #000000;
      text-align: center;
      font-size: 14px;
      font-weight: 700;
      padding: 5px 8px;
      border: 1px solid #000000;
    }

    .sheet-banner-yellow {
      background: #ffff00;
      color: #000000;
      text-align: center;
      font-size: 12px;
      font-weight: 700;
      padding: 4px 8px;
      border: 1px solid #000000;
      border-top: none;
    }

    table.excel-table {
      width: 100%;
      min-width: 1080px;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 11px;
      color: #000000;
    }

    table.excel-table th,
    table.excel-table td {
      border: 1px solid #000000;
      padding: 2px 4px;
      height: 21px;
      vertical-align: middle;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .hdr-peach {
      background-color: #f4b084;
      font-weight: 700;
      text-align: center;
    }

    .bg-green {
      background-color: #00b050 !important;
      color: #000000;
      font-weight: 700;
    }

    .bg-yellow {
      background-color: #ffff00 !important;
      color: #000000;
      font-weight: 700;
    }

    .text-center { text-align: center; }
    .text-right { text-align: right; }
    .bold { font-weight: 700; }

    td[contenteditable="true"]:focus {
      outline: 2px solid #16a34a;
      background-color: #f0fdf4;
    }

    .action-links {
      display: flex;
      justify-content: center;
      gap: 5px;
      font-size: 10px;
      font-weight: 700;
    }

    .link-receipt {
      color: #059669;
      cursor: pointer;
      text-decoration: underline;
      background: none;
      border: none;
      font-size: 10px;
      font-weight: 700;
    }

    .link-delete {
      color: #dc2626;
      cursor: pointer;
      text-decoration: underline;
      background: none;
      border: none;
      font-size: 10px;
      font-weight: 700;
    }

    .sheet-footer-note {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 6px;
      font-size: 11px;
      color: var(--muted);
    }

    @media (max-width: 1200px) {
      .entry-inputs-grid { grid-template-columns: repeat(2, 1fr); }
      .kpi-grid-4 { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 1150px) {
      .top-strip { grid-template-columns: repeat(2, 1fr); }
      .date-box { grid-column: 1 / -1; }
      .strip-kpi { border-right: none; padding-right: 0; }
      .tx-kpi-row { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 1100px) {
      .app-shell.unlocked { grid-template-columns: 1fr; }
      .officials-grid, .kpi-grid-4, .grid-2 { grid-template-columns: 1fr; }
    }

    @page {
      size: A4 landscape;
      margin: 6mm;
    }

    @media print {
      body { background: #ffffff !important; color: #000000 !important; padding: 0 !important; }
      .lock-screen, .sidebar, .topbar, #dashboardPane, .entry-box, .tx-kpi-row, .sheet-controls, .sheet-footer-note, .no-print {
        display: none !important;
      }
      .app-shell.unlocked, .main-content, .page-body, #sheetPane, .bi-card {
        display: block !important;
        background: #ffffff !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      .excel-container { border: 1.5px solid #000000 !important; padding: 4px !important; overflow: visible !important; }
      table.excel-table { min-width: 100% !important; font-size: 9.5px !important; }
      table.excel-table th, table.excel-table td {
        height: 18px !important;
        padding: 2px 4px !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }
  </style>
</head>
<body>

  <!-- GENERAL ACCOUNTS পাসওয়ার্ড লক স্ক্রিন -->
  <div class="lock-screen" id="lockScreen">
    <form class="lock-card" id="unlockForm">
      <span class="lock-badge">PROTECTED MODULE</span>
      <h1>GENERAL ACCOUNTS</h1>
      <p>IDEAL TECHNICAL TRAINING &amp; TESTING CENTER — হিসাব বিভাগে প্রবেশ করতে পাসওয়ার্ড দিন (ডিফল্ট পাসওয়ার্ড: <strong>1234</strong>)</p>
      <input type="password" class="lock-input" id="passwordInput" placeholder="পাসওয়ার্ড লিখুন..." required autofocus />
      <div class="lock-error" id="lockError"></div>
      <button type="submit" class="btn">🔓 লগইন করে প্রবেশ করুন</button>
    </form>
  </div>

  <!-- লগইন করার পর GENERAL ACCOUNTS -->
  <div class="app-shell" id="appShell">
    <aside class="sidebar">
      <div>
        <div class="brand-box">
          <div class="brand-logo">GA</div>
          <div>
            <div class="brand-title">GENERAL ACCOUNTS</div>
            <div class="brand-sub">ITTC Center • Accounts Only</div>
          </div>
        </div>

        <div class="nav-list">
          <button type="button" class="nav-btn active" data-pane="dashboardPane">
            <span>📊 হিসাব সামারি (Dashboard)</span>
          </button>
          <button type="button" class="nav-btn" data-pane="sheetPane">
            <span>📑 নতুন হিসাব লেনদেন</span>
          </button>
        </div>
      </div>

      <button type="button" class="btn btn-secondary" id="lockBtn">🔒 Lock Accounts</button>
    </aside>

    <div class="main-content">
      <header class="topbar">
        <div class="topbar-left">
          <h2>IDEAL TECHNICAL TRAINING &amp; TESTING CENTER</h2>
          <span>GENERAL ACCOUNTS • হিসাব লেনদেন ও সামারি</span>
        </div>

        <div class="topbar-right">
          <button type="button" class="btn btn-blue" id="exportJsonBtn">💾 Backup</button>
          <button type="button" class="btn btn-secondary" id="importJsonBtn">📂 Restore</button>
          <input type="file" id="jsonFileInput" accept="application/json" style="display:none;" />
          <button type="button" class="btn" id="topExportXlsxBtn">📊 Download XL (.xlsx)</button>
          <button type="button" class="btn btn-pink" id="printPdfBtn">📄 Download PDF</button>
        </div>
      </header>

      <div class="page-body">
        <!-- ট্যাব ১: হিসাব সামারি ড্যাশবোর্ড -->
        <section class="tab-pane active" id="dashboardPane">
          <div class="top-strip">
            <div class="strip-kpi">
              <span class="strip-label">মোট নগদ টাকা</span>
              <span class="strip-val income-text" id="cardTotalCash">৳২৭৯৮২৩</span>
              <span class="strip-sub" id="subCashBreakdown">পূর্বের: ৳২১৫৪২৩ + নতুন: ৳৬৪৪০০</span>
