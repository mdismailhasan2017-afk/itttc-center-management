    function updateCell(id, field, rawVal) {
      if (state.lockedDates[state.activeDate]) {
        renderSheet();
        return;
      }
      const idx = state.rows.findIndex(r => r.id === id);
      if (idx === -1) return;
      if (['incCash', 'incBank', 'expAmt'].includes(field)) {
        const num = parseFloat(rawVal.replace(/,/g, '').trim()) || 0;
        state.rows[idx][field] = num;
      } else {
        state.rows[idx][field] = rawVal.trim();
      }
      saveState();
      renderAll();
    }

    // Print / PDF
    function triggerPrintPdf() {
      switchPane('sheetPane');
      setTimeout(() => window.print(), 200);
    }
    document.getElementById('printPdfBtn').addEventListener('click', triggerPrintPdf);
    document.getElementById('sheetPrintBtn').addEventListener('click', triggerPrintPdf);

    // Backup & Restore
    document.getElementById('exportJsonBtn').addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      saveAs(blob, `ITTC_Accounts_Backup_${state.activeDate}.json`);
    });

    document.getElementById('importJsonBtn').addEventListener('click', () => {
      document.getElementById('jsonFileInput').click();
    });

    document.getElementById('jsonFileInput').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => {
        try {
          const parsed = JSON.parse(ev.target.result);
          if (parsed && Array.isArray(parsed.rows)) {
            state = parsed;
            saveState();
            document.getElementById('txVoucher').value = getNextVoucherSuggestion();
            renderAll();
            alert('ব্যাকআপ সফলভাবে রিস্টোর হয়েছে!');
          }
        } catch (err) { alert('সঠিক ব্যাকআপ ফাইল নির্বাচন করুন।'); }
      };
      reader.readAsText(file);
    });

    // Styled Excel (.xlsx) Export
    async function exportStyledExcel() {
      const d = state.activeDate;
      const dayName = getDayNameFromDot(d);
      const sum = getDaySummary(d);
      const slashDate = toBn(d.replace(/\./g, '/'));
      const openBankCombined = (Number(sum.opening.bank) || 0) + (Number(sum.opening.bkash) || 0);

      const wb = new ExcelJS.Workbook();
      const ws = wb.addWorksheet('দৈনিক হিসাব', {
        pageSetup: { paperSize: 9, orientation: 'landscape', fitToPage: true, fitToWidth: 1, fitToHeight: 1 }
      });

      ws.columns = [
        { width: 13 }, { width: 36 }, { width: 13 }, { width: 14 },
        { width: 34 }, { width: 13 }, { width: 13 }, { width: 13 },
        { width: 14 }, { width: 14 }, { width: 15 }
      ];

      const border = {
        top: { style: 'thin', color: { argb: 'FF000000' } },
        left: { style: 'thin', color: { argb: 'FF000000' } },
        bottom: { style: 'thin', color: { argb: 'FF000000' } },
        right: { style: 'thin', color: { argb: 'FF000000' } }
      };

      const greenFill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF00B050' } };
      const yellowFill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFF00' } };
      const peachFill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFF4B084' } };

      ws.mergeCells('A1:K1');
      ws.getCell('A1').value = 'আইডিয়াল টেকনিক্যাল ট্রেনিং এন্ড টেস্টিং সেন্টার';
      ws.getCell('A1').fill = greenFill;
      ws.getCell('A1').font = { size: 16, bold: true, color: { argb: 'FF000000' } };
      ws.getCell('A1').alignment = { horizontal: 'center', vertical: 'middle' };
      ws.getRow(1).height = 28;

      ws.mergeCells('A2:K2');
      ws.getCell('A2').value = `দৈনিক আয় ব্যয়ের হিসাব ${slashDate} (${dayName})`;
      ws.getCell('A2').fill = yellowFill;
      ws.getCell('A2').font = { size: 13, bold: true, color: { argb: 'FF000000' } };
      ws.getCell('A2').alignment = { horizontal: 'center', vertical: 'middle' };
      ws.getRow(2).height = 22;

      ws.mergeCells('A3:A4'); ws.getCell('A3').value = 'তারিখ';
      ws.mergeCells('B3:D3'); ws.getCell('B3').value = 'আয়';
      ws.mergeCells('E3:F3'); ws.getCell('E3').value = 'ব্যয়';
      ws.mergeCells('G3:G4'); ws.getCell('G3').value = 'নগদ টাকা';
      ws.mergeCells('H3:H4'); ws.getCell('H3').value = 'ব্যয়ের টাকা';
      ws.mergeCells('I3:I4'); ws.getCell('I3').value = 'ব্যাংক/বিকাশ';
      ws.mergeCells('J3:J4'); ws.getCell('J3').value = 'নগদ ব্যালেন্স';
      ws.mergeCells('K3:K4'); ws.getCell('K3').value = 'নগদ + ব্যাংক';

      ws.getCell('B4').value = 'আয়ের মাধ্যম / ভাউচার';
      ws.getCell('C4').value = 'নগদ টাকা';
      ws.getCell('D4').value = 'ব্যাংক/বিকাশ';
      ws.getCell('E4').value = 'ব্যয়ের মাধ্যম';
      ws.getCell('F4').value = 'ব্যয়ের টাকা';

      [3, 4].forEach(r => {
        ws.getRow(r).height = 20;
        for (let c = 1; c <= 11; c++) {
          const cell = ws.getRow(r).getCell(c);
          cell.fill = peachFill;
          cell.font = { size: 11, bold: true };
          cell.alignment = { horizontal: 'center', vertical: 'middle' };
          cell.border = border;
        }
      });

      const r5 = ws.getRow(5);
      r5.height = 20;
      r5.values = [
        sum.opening.prevDate, 'পূর্বের ব্যালেন্স', sum.opening.cash || null, openBankCombined || null,
        'পূর্বের ব্যালেন্স', null, sum.opening.cash || null, null, openBankCombined || null, null, null
      ];
      for (let c = 1; c <= 11; c++) {
        const cell = r5.getCell(c);
        cell.font = { size: 11, bold: true };
        cell.border = border;
        if (c === 1) cell.alignment = { horizontal: 'center', vertical: 'middle' };
        else if ([3, 4, 7, 9].includes(c)) {
          cell.alignment = { horizontal: 'right', vertical: 'middle' };
          cell.numFmt = '#,##0';
        }
      }
      r5.getCell(3).fill = greenFill;
      r5.getCell(4).fill = yellowFill;
      r5.getCell(7).fill = greenFill;
      r5.getCell(9).fill = yellowFill;

      let idx = 6;
      sum.dayRows.forEach(r => {
        const incDisplay = `${r.voucher ? `[${r.voucher}] ` : ''}${r.incSrc || ''}${r.account ? ` (${r.account})` : ''}`;
        const row = ws.getRow(idx);
        row.height = 19;
        row.values = [
          r.date, incDisplay, r.incCash || null, r.incBank || null,
          r.expSrc || '', r.expAmt || null, r.incCash || null, r.expAmt || null, r.incBank || null, null, null
        ];
        for (let c = 1; c <= 11; c++) {
          const cell = row.getCell(c);
          cell.font = { size: 10.5 };
          cell.border = border;
          if (c === 1) cell.alignment = { horizontal: 'center', vertical: 'middle' };
          else if ([3, 4, 6, 7, 8, 9].includes(c)) {
            cell.alignment = { horizontal: 'right', vertical: 'middle' };
            cell.numFmt = '#,##0';
          }
        }
        if (r.incBank > 0) {
          row.getCell(4).fill = greenFill;
          row.getCell(9).fill = greenFill;
        }
        idx++;
      });

      const lastPad = Math.max(idx + 4, 30);
      while (idx <= lastPad) {
        const row = ws.getRow(idx);
        row.height = 18;
        for (let c = 1; c <= 11; c++) row.getCell(c).border = border;
        idx++;
      }

      const bankRowIdx = idx;
      const rB = ws.getRow(bankRowIdx);
      rB.height = 20;
      rB.getCell(2).value = 'ব্যাংকে/বিকাশে জমা আছে=';
      rB.getCell(5).value = 'ব্যাংকে/বিকাশে জমা আছে=';
      rB.getCell(5).alignment = { horizontal: 'right', vertical: 'middle' };
      for (let c = 1; c <= 11; c++) {
        rB.getCell(c).font = { size: 11, bold: true };
        rB.getCell(c).border = border;
      }

      const totIdx = bankRowIdx + 1;
      const lastData = bankRowIdx - 1;
      const rT = ws.getRow(totIdx);
      rT.height = 22;

      rT.getCell(3).value = { formula: `SUM(C5:C${lastData})` };
      rT.getCell(4).value = { formula: `SUM(D5:D${lastData})` };
      rT.getCell(5).value = 'ক্যাশে জমা আছে=';
      rT.getCell(5).alignment = { horizontal: 'right', vertical: 'middle' };
      rT.getCell(6).value = { formula: `SUM(F6:F${lastData})` };
      rT.getCell(7).value = { formula: `SUM(G5:G${lastData})` };
      rT.getCell(8).value = { formula: `SUM(H6:H${lastData})` };
      rT.getCell(9).value = { formula: `SUM(I5:I${lastData})` };
      rT.getCell(10).value = { formula: `G${totIdx}-H${totIdx}` };
      rT.getCell(11).value = { formula: `J${totIdx}+I${totIdx}` };

      for (let c = 1; c <= 11; c++) {
        const cell = rT.getCell(c);
        cell.font = { size: 11, bold: true };
        cell.border = border;
        if ([3, 4, 6, 7, 8, 9, 10, 11].includes(c)) {
          cell.alignment = { horizontal: 'right', vertical: 'middle' };
          cell.numFmt = '#,##0';
        }
      }
      [3, 4, 7, 9, 10, 11].forEach(c => { rT.getCell(c).fill = greenFill; });
      [6, 8].forEach(c => { rT.getCell(c).fill = yellowFill; });

      const buf = await wb.xlsx.writeBuffer();
      saveAs(new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), `ITTC_Accounts_${d}.xlsx`);
    }

    document.getElementById('exportXlsxBtn').addEventListener('click', exportStyledExcel);
    document.getElementById('topExportXlsxBtn').addEventListener('click', exportStyledExcel);

    loadState();
  </script>
</body>
</html>