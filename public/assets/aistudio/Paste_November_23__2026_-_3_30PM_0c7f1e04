  <script>
    const STORAGE_KEY = "itttc_general_accounts_officials_v1";

    const defaultRows = [
      { isOpening: true, date: "২১.১১.২০২৬", inDesc: "পূর্বের ব্যালেন্স", inCash: "২১৫৪২৩", inBank: "৫৪৩৫৭০", outDesc: "পূর্বের ব্যালেন্স", outCash: "" },
      { date: "২২.১১.২০২৬", inDesc: "সাইফুল ইসলাম WELDING JOB FEE ১৩/২২১ (৪৫৮২)", inCash: "১০০০০", inBank: "", outDesc: "", outCash: "" },
      { date: "২২.১১.২০২৬", inDesc: "রাওহা WELDING JOB FEE ১০/২৮৫ (৪৫৩৩)", inCash: "৫৪০০", inBank: "", outDesc: "মাস্ক ক্রয়", outCash: "১০০" },
      { date: "২২.১১.২০২৬", inDesc: "মেহেদী WELDING JOB FEE ১৩/৩৮৯ (৪৫৮৪)", inCash: "১০০০০", inBank: "", outDesc: "মেহেদী ১৩/২৮৯ জব ফি ফেরত দেওয়া হলো", outCash: "৫৪০০" },
      { date: "২২.১১.২০২৬", inDesc: "নাহিদ হাসান WELDING JOB FEE নতুন ভর্তি (৪৫৮৫)", inCash: "১০০০০", inBank: "", outDesc: "গাড়ি ভাড়া", outCash: "২০০" },
      { date: "২২.১১.২০২৬", inDesc: "নাহিদ হাসান PP ফি নতুন ভর্তি (৪৫৮৫)", inCash: "১০০০", inBank: "", outDesc: "SOHEL KAZI অনলাইন পার্সেল", outCash: "১১১০" },
      { date: "২২.১১.২০২৬", inDesc: "লিমন WELDING JOB FEE নতুন ভর্তি (৪৫৮৬)", inCash: "১৫০০০", inBank: "", outDesc: "নাজমুল ভাইকে নভেম্বর মাসের বেতন থেকে অগ্রীম", outCash: "৫০০" },
      { date: "২২.১১.২০২৬", inDesc: "লিমন PP ফি নতুন ভর্তি (৪৫৮৬)", inCash: "১৫০০", inBank: "", outDesc: "মাসুদ রানা এন্টারপ্রাইজকে প্রদান", outCash: "২০০০০" },
      { date: "২২.১১.২০২৬", inDesc: "রায়হান WELDING JOB FEE নতুন ভর্তি (৪৫৮৭)", inCash: "১০০০০", inBank: "২২৪০০০", outDesc: "ব্যাংকে জমা", outCash: "২২৪০০০" },
      { date: "২২.১১.২০২৬", inDesc: "রায়হান PP ফি নতুন ভর্তি (৪৫৮৭)", inCash: "১৫০০", inBank: "", outDesc: "", outCash: "" },
      { date: "২২.১১.২০২৬", inDesc: "", inCash: "", inBank: "", outDesc: "", outCash: "" },
      { date: "২২.১১.২০২৬", inDesc: "", inCash: "", inBank: "", outDesc: "", outCash: "" }
    ];

    let rowsData = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null") || JSON.parse(JSON.stringify(defaultRows));

    const sheetBody = document.getElementById("sheetBody");
    const entryForm = document.getElementById("entryForm");
    const searchInput = document.getElementById("searchInput");
    const filterMode = document.getElementById("filterMode");
    const dashDateFilter = document.getElementById("dashDateFilter");

    function switchTab(targetId) {
      document.querySelectorAll(".tab-btn").forEach(b => {
        b.classList.toggle("active", b.getAttribute("data-target") === targetId);
      });
      document.querySelectorAll(".view-section").forEach(sec => {
        sec.classList.toggle("active", sec.id === targetId);
      });
    }

    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.addEventListener("click", () => switchTab(btn.getAttribute("data-target")));
    });

    function bnToEn(str) {
      return String(str || "")
        .replace(/[০-৯]/g, d => "০১২৩৪৫৬৭৮৯".indexOf(d))
        .replace(/[^\d.-]/g, "");
    }

    function enToBn(num) {
      if (num === "" || num === null || isNaN(num)) return "";
      const bnDigits = ["০", "১", "২", "৩", "৪", "৫", "৬", "৭", "৮", "৯"];
      return String(Math.round(num)).replace(/\d/g, d => bnDigits[d]);
    }

    function parseNum(val) {
      const n = parseFloat(bnToEn(val));
      return isNaN(n) ? 0 : n;
    }

    function saveRows() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(rowsData));
    }

    function syncDashDateSelect() {
      const current = dashDateFilter.value;
      const dates = Array.from(new Set(rowsData.map(r => (r.date || "").trim()).filter(Boolean)));
      dashDateFilter.innerHTML = `<option value="ALL">সব তারিখ</option>` +
        dates.map(d => `<option value="${d}">তারিখ: ${d}</option>`).join("");
      if (Array.from(dashDateFilter.options).some(o => o.value === current)) {
        dashDateFilter.value = current;
      } else {
        dashDateFilter.value = "ALL";
      }
    }

    function renderOfficialGraph(containerId, items, colorHex) {
      const box = document.getElementById(containerId);
      if (!items.length) {
        box.innerHTML = `<div style="width:100%; text-align:center; font-size:11.5px; color:var(--muted); align-self:center;">কোনো উত্তোলন নেই</div>`;
        return;
      }
      const maxVal = Math.max(...items.map(i => i.amount), 1);
      box.innerHTML = items.slice(-5).map(item => {
        const pct = Math.max(12, Math.round((item.amount / maxVal) * 75));
        return `
          <div class="bar-col">
            <span class="bar-val">৳${enToBn(item.amount)}</span>
            <div class="bar-fill" style="height:${pct}%; background:${colorHex};"></div>
            <span class="bar-lbl">${item.label}</span>
          </div>
        `;
      }).join("");
    }

    function renderTable() {
      syncDashDateSelect();
      const q = searchInput.value.trim().toLowerCase();
      const mode = filterMode.value;

      sheetBody.innerHTML = "";

      rowsData.forEach((row, idx) => {
        const hasIncome = parseNum(row.inCash) > 0 || parseNum(row.inBank) > 0;
        const hasExpense = parseNum(row.outCash) > 0;

        if (!row.isOpening) {
          if (mode === "income" && !hasIncome) return;
          if (mode === "expense" && !hasExpense) return;
          if (q) {
            const combined = `${row.date} ${row.inDesc} ${row.outDesc}`.toLowerCase();
            if (!combined.includes(q)) return;
          }
        }

        const tr = document.createElement("tr");
        const inCashClass = row.isOpening ? "bg-green" : "";
        const inBankClass = row.isOpening ? "bg-yellow" : (parseNum(row.inBank) > 0 ? "bg-green" : "");

        tr.innerHTML = `
          <td class="text-center" contenteditable="true" data-idx="${idx}" data-field="date">${row.date || ""}</td>
          <td contenteditable="true" data-idx="${idx}" data-field="inDesc">${row.inDesc || ""}</td>
          <td class="text-center ${inCashClass}" contenteditable="true" data-idx="${idx}" data-field="inCash">${row.inCash || ""}</td>
          <td class="text-center ${inBankClass}" contenteditable="true" data-idx="${idx}" data-field="inBank">${row.inBank || ""}</td>
          <td contenteditable="true" data-idx="${idx}" data-field="outDesc">${row.outDesc || ""}</td>
          <td class="text-center" contenteditable="true" data-idx="${idx}" data-field="outCash">${row.outCash || ""}</td>
          <td class="text-center ${inCashClass}">${row.inCash || ""}</td>
          <td class="text-center">${row.outCash || ""}</td>
          <td class="text-center ${inBankClass}">${row.inBank || ""}</td>
          <td></td>
          <td></td>
          <td class="text-center no-print">
            ${row.isOpening ? "" : `<button type="button" class="row-del-btn" onclick="removeRow(${idx})">×</button>`}
          </td>
        `;
        sheetBody.appendChild(tr);
      });

      recalculateDashboard();
    }

    function recalculateDashboard() {
      let totalInCash = 0;
      let totalInBank = 0;
      let totalOutCash = 0;

      const selectedDate = dashDateFilter.value;
      let ppSelected = 0;
      let weldingSelected = 0;
      let pipeSelected = 0;

      const dailyCatMap = {};

      let mdTotal = 0;
      let dirTotal = 0;
      let gmTotal = 0;

      const mdItems = [];
      const dirItems = [];
      const gmItems = [];
      const officialLedgerRows = [];

      rowsData.forEach(r => {
        const cIn = parseNum(r.inCash);
        const bIn = parseNum(r.inBank);
        const cOut = parseNum(r.outCash);

        totalInCash += cIn;
        totalInBank += bIn;
        totalOutCash += cOut;

        const descIn = (r.inDesc || "").toUpperCase();
        const descOut = (r.outDesc || "").toUpperCase();
        const dt = (r.date || "").trim();

        const isPP = descIn.includes("PP") || descIn.includes("পিপিই");
        const isPipe = descIn.includes("PIPE") || descIn.includes("FITTER") || descIn.includes("পাইপ");
        const isWelding = !isPP && !isPipe && (descIn.includes("WELDING") || descIn.includes("JOB") || descIn.includes("জব"));

        const amtIn = cIn + bIn;

        if (dt && !r.isOpening) {
          if (!dailyCatMap[dt]) {
            dailyCatMap[dt] = { pp: 0, welding: 0, pipe: 0 };
          }
          if (isPP) dailyCatMap[dt].pp += amtIn;
          if (isWelding) dailyCatMap[dt].welding += amtIn;
          if (isPipe) dailyCatMap[dt].pipe += amtIn;
        }

        if (!r.isOpening && (selectedDate === "ALL" || dt === selectedDate)) {
          if (isPP) ppSelected += amtIn;
          if (isWelding) weldingSelected += amtIn;
          if (isPipe) pipeSelected += amtIn;
        }

        // Officials tracking from Expense column
        if (!r.isOpening && cOut > 0) {
          if (descOut.includes("SABUJ") || descOut.includes("সবুজ")) {
            mdTotal += cOut;
            mdItems.push({ label: dt || "এন্ট্রি", amount: cOut });
            officialLedgerRows.push({ person: "SABUJ KAZI (MD)", note: `${dt} — ${r.outDesc}`, amt: cOut });
          } else if (descOut.includes("SOHEL") || descOut.includes("সোহেল")) {
            dirTotal += cOut;
            dirItems.push({ label: dt || "এন্ট্রি", amount: cOut });
            officialLedgerRows.push({ person: "SOHEL KAZI (Director)", note: `${dt} — ${r.outDesc}`, amt: cOut });
          } else if (descOut.includes("SALIM") || descOut.includes("সালিম")) {
            gmTotal += cOut;
            gmItems.push({ label: dt || "এন্ট্রি", amount: cOut });
            officialLedgerRows.push({ person: "SALIM MAHMMUD (GM)", note: `${dt} — ${r.outDesc}`, amt: cOut });
          }
        }
      });

      const netCash = totalInCash - totalOutCash;
      const netTotal = netCash + totalInBank;

      const bnInCash = enToBn(totalInCash);
      const bnInBank = enToBn(totalInBank);
      const bnOutCash = enToBn(totalOutCash);
      const bnNetCash = enToBn(netCash);
      const bnNetTotal = enToBn(netTotal);

      // Excel Footer Totals
      document.getElementById("totInCashLeft").textContent = bnInCash;
      document.getElementById("totInCashRight").textContent = bnInCash;
      document.getElementById("totInBankLeft").textContent = bnInBank;
      document.getElementById("totInBankRight").textContent = bnInBank;
      document.getElementById("totOutLeft").textContent = bnOutCash;
      document.getElementById("totOutRight").textContent = bnOutCash;
      document.getElementById("netCashBalance").textContent = bnNetCash;
      document.getElementById("netCashPlusBank").textContent = bnNetTotal;

      // Top 3 Category Cards
      document.getElementById("ppDepositVal").textContent = "৳" + enToBn(ppSelected);
      document.getElementById("weldingJobFeeVal").textContent = "৳" + enToBn(weldingSelected);
      document.getElementById("pipeFitterFeeVal").textContent = "৳" + enToBn(pipeSelected);

      // Overall Cards
      document.getElementById("cardTotalCash").textContent = "৳" + bnInCash;
      document.getElementById("cardTotalExpense").textContent = "৳" + bnOutCash;
      document.getElementById("cardTotalBank").textContent = "৳" + bnInBank;
      document.getElementById("cardNetBalance").textContent = `৳${bnNetCash} / ৳${bnNetTotal}`;

      // 3 Officials Totals & Separate Graphs
      document.getElementById("mdTotalVal").textContent = "৳" + enToBn(mdTotal);
      document.getElementById("dirTotalVal").textContent = "৳" + enToBn(dirTotal);
      document.getElementById("gmTotalVal").textContent = "৳" + enToBn(gmTotal);

      renderOfficialGraph("mdGraph", mdItems, "#f97316");
      renderOfficialGraph("dirGraph", dirItems, "#3b82f6");
      renderOfficialGraph("gmGraph", gmItems, "#22c55e");

      // Daily Category Summary Table
      const catBody = document.getElementById("dailyCategorySummaryBody");
      const catEntries = Object.entries(dailyCatMap);
      catBody.innerHTML = catEntries.length
        ? catEntries.map(([d, v]) => `
            <tr>
              <td><strong>${d}</strong></td>
              <td class="income-text">৳${enToBn(v.pp)}</td>
              <td class="blue-text">৳${enToBn(v.welding)}</td>
              <td class="purple-text">৳${enToBn(v.pipe)}</td>
            </tr>
          `).join("")
        : `<tr><td colspan="4" style="text-align:center; color:var(--muted);">কোনো তথ্য নেই</td></tr>`;

      // Officials Ledger Table
      const offBody = document.getElementById("officialsLedgerBody");
      offBody.innerHTML = officialLedgerRows.length
        ? officialLedgerRows.map(o => `
            <tr>
              <td><strong>${o.person}</strong></td>
              <td>${o.note}</td>
              <td class="expense-text">৳${enToBn(o.amt)}</td>
            </tr>
          `).join("")
        : `<tr><td colspan="3" style="text-align:center; color:var(--muted);">এখনো কোনো উত্তোলন যুক্ত হয়নি</td></tr>`;
    }

    window.addOfficialDraw = function(officialName, amtInputId, noteInputId) {
      const amtEl = document.getElementById(amtInputId);
      const noteEl = document.getElementById(noteInputId);
      const amount = parseNum(amtEl.value);
      if (!amount || amount <= 0) return;

      const noteText = noteEl.value.trim();
      const desc = `${officialName}${noteText ? " — " + noteText : ""}`;
      const currentDate = dashDateFilter.value !== "ALL" ? dashDateFilter.value : "২২.১১.২০২৬";

      rowsData.push({
        date: currentDate,
        inDesc: "",
        inCash: "",
        inBank: "",
        outDesc: desc,
        outCash: enToBn(amount)
      });

      amtEl.value = "";
      noteEl.value = "";
      saveRows();
      renderTable();
    };

    sheetBody.addEventListener("input", e => {
      const cell = e.target;
      const idx = cell.getAttribute("data-idx");
      const field = cell.getAttribute("data-field");
      if (idx === null || !field) return;

      rowsData[idx][field] = cell.textContent.trim();

      const tr = cell.parentElement;
      if (field === "inCash") tr.children[6].textContent = rowsData[idx].inCash;
      if (field === "outCash") tr.children[7].textContent = rowsData[idx].outCash;
      if (field === "inBank") {
        tr.children[8].textContent = rowsData[idx].inBank;
        if (!rowsData[idx].isOpening) {
          const hasBank = parseNum(rowsData[idx].inBank) > 0;
          cell.classList.toggle("bg-green", hasBank);
          tr.children[8].classList.toggle("bg-green", hasBank);
        }
      }

      saveRows();
      recalculateDashboard();
    });

    window.removeRow = function(idx) {
      rowsData.splice(idx, 1);
      saveRows();
      renderTable();
    };

    entryForm.addEventListener("submit", e => {
      e.preventDefault();
      const dateVal = document.getElementById("fDate").value.trim();
      const typeVal = document.getElementById("fEntryType").value;
      const descVal = document.getElementById("fDesc").value.trim();
      const amtBn = enToBn(parseNum(document.getElementById("fAmount").value));

      const newRow = { date: dateVal, inDesc: "", inCash: "", inBank: "", outDesc: "", outCash: "" };

      if (typeVal === "incomeCash") {
        newRow.inDesc = descVal;
        newRow.inCash = amtBn;
      } else if (typeVal === "expenseCash") {
        newRow.outDesc = descVal;
        newRow.outCash = amtBn;
      } else if (typeVal === "bankDeposit") {
        newRow.inBank = amtBn;
        newRow.outDesc = descVal || "ব্যাংকে জমা";
        newRow.outCash = amtBn;
      }

      const firstBlankIndex = rowsData.findIndex(r => !r.isOpening && !r.inDesc && !r.outDesc && !r.inCash && !r.outCash && !r.inBank);
      if (firstBlankIndex !== -1) {
        rowsData[firstBlankIndex] = newRow;
      } else {
        rowsData.push(newRow);
      }

      document.getElementById("fDesc").value = "";
      document.getElementById("fAmount").value = "";
      saveRows();
      renderTable();
    });

    document.getElementById("addBlankRowBtn").addEventListener("click", () => {
      rowsData.push({ date: "২২.১১.২০২৬", inDesc: "", inCash: "", inBank: "", outDesc: "", outCash: "" });
      saveRows();
      renderTable();
    });

    document.getElementById("resetSampleBtn").addEventListener("click", () => {
      rowsData = JSON.parse(JSON.stringify(defaultRows));
      saveRows();
      renderTable();
    });

    document.getElementById("printPdfBtn").addEventListener("click", () => {
      switchTab("sheetView");
      setTimeout(() => window.print(), 100);
    });

    document.getElementById("exportJsonBtn").addEventListener("click", () => {
      const blob = new Blob([JSON.stringify(rowsData, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "itttc-general-accounts.json";
      a.click();
      URL.revokeObjectURL(url);
    });

    const jsonFileInput = document.getElementById("jsonFileInput");
    document.getElementById("importJsonBtn").addEventListener("click", () => jsonFileInput.click());
    jsonFileInput.addEventListener("change", e => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const parsed = JSON.parse(reader.result);
          if (Array.isArray(parsed)) {
            rowsData = parsed;
            saveRows();
            renderTable();
          }
        } catch (_) {}
      };
      reader.readAsText(file);
    });

    dashDateFilter.addEventListener("change", recalculateDashboard);
    searchInput.addEventListener("input", renderTable);
    filterMode.addEventListener("change", renderTable);

    renderTable();
  </script>
</body>
</html>