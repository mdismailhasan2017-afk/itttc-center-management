        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "cat", "price", "limit", "active", "createdAt", "updatedAt"]
    },
    "JobReturn": {
      "title": "Job Return / Retrain",
      "description": "Log of returned, retrained, or reworked practical test jobs.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 1, "maxLength": 60 },
        "no": { "type": "string", "minLength": 1, "maxLength": 80 },
        "code": { "type": "string", "maxLength": 80 },
        "sname": { "type": "string", "maxLength": 420 },
        "cat": { "type": "string", "maxLength": 200 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 750 },
        "act": { "type": "string", "enum": ["Retrain", "Plate Return", "Failed / Rework"] },
        "fee": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
