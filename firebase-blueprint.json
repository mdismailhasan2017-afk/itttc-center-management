        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 200 },
        "demand": { "type": "string", "maxLength": 160 },
        "contractsCount": { "type": "number" },
        "workersCount": { "type": "number" },
        "note": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "name", "country", "contact", "phone", "address", "demand", "contractsCount", "workersCount", "note", "createdAt", "updatedAt"]
    },
    "AgencyContract": {
      "title": "Agency Contract",
      "description": "Overseas agency hiring history and worker deployment contract.",
