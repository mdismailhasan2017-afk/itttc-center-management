        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "staffId", "staffName", "month", "amount", "method", "note", "createdAt", "updatedAt"]
    },
    "OverseasCompany": {
      "title": "Overseas Company",
      "description": "Foreign client / recruitment partner organization.",
