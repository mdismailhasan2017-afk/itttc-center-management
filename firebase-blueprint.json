{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public profile for an authenticated center operator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "staff", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "User Private Info",
      "description": "Isolated PII record for an authenticated user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "Admin Record",
      "description": "Authorized super admin registry document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Center": {
      "title": "Training Center",
      "description": "ITTC center workspace configuration and security credentials.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "subtitle": { "type": "string", "maxLength": 400 },
        "address": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 60 },
        "slipFooter": { "type": "string", "maxLength": 400 },
        "accountsPass": { "type": "string", "maxLength": 60 },
        "generalAccountsPass": { "type": "string", "maxLength": 60 },
        "adminUser": { "type": "string", "maxLength": 60 },
        "adminPass": { "type": "string", "maxLength": 60 },
        "navOrder": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "subtitle", "address", "phone", "slipFooter", "accountsPass", "adminUser", "adminPass", "navOrder", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Registered trainee with photo, biometric status, family info, contract, job balance, and overseas status.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 1, "maxLength": 60 },
        "name": { "type": "string", "minLength": 1, "maxLength": 420 },
        "code": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fatherName": { "type": "string", "maxLength": 360 },
        "motherName": { "type": "string", "maxLength": 360 },
        "phone": { "type": "string", "maxLength": 60 },
        "guardianPhone": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 480 },
        "nid": { "type": "string", "maxLength": 60 },
        "trade": { "type": "string", "maxLength": 200 },
        "passportSubmitted": { "type": "boolean" },
        "passportNo": { "type": "string", "maxLength": 60 },
        "passportCopyData": { "type": "string", "maxLength": 150000 },
        "photoData": { "type": "string", "maxLength": 150000 },
        "bioEnrolled": { "type": "boolean" },
        "companyName": { "type": "string", "maxLength": 360 },
        "interviewPassedCompany": { "type": "string", "maxLength": 420 },
        "interviewDate": { "type": "string", "maxLength": 60 },
        "overseasStatus": { "type": "string", "enum": ["Not Applied", "Interview Attended", "Selected", "Visa Processing", "Flight Ready"] },
        "destination": { "type": "string", "maxLength": 200 },
        "contract": { "type": "number" },
        "deposit": { "type": "number" },
        "note": { "type": "string", "maxLength": 900 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "name", "code", "fatherName", "motherName", "phone", "guardianPhone", "district", "nid", "trade", "passportSubmitted", "passportNo", "passportCopyData", "photoData", "bioEnrolled", "companyName", "interviewPassedCompany", "interviewDate", "overseasStatus", "destination", "contract", "deposit", "note", "createdAt", "updatedAt"]
    },
    "JobEntry": {
      "title": "Daily Job Entry",
      "description": "Practical test job registered for a student with discount, payable, and verification method.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 1, "maxLength": 60 },
        "no": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sid": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sname": { "type": "string", "minLength": 1, "maxLength": 420 },
        "cat": { "type": "string", "minLength": 1, "maxLength": 200 },
        "pay": { "type": "number" },
        "discount": { "type": "number" },
        "paid": { "type": "number" },
        "verificationMethod": { "type": "string", "enum": ["biometric", "supervisor"] },
        "note": { "type": "string", "maxLength": 750 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "no", "sid", "sname", "cat", "pay", "discount", "paid", "verificationMethod", "note", "createdAt", "updatedAt"]
    },
    "OutStudentJob": {
      "title": "Out of Student Job",
      "description": "Walk-in / external trainee practical test entry with agent and payment ref.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 1, "maxLength": 60 },
        "no": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 420 },
        "phone": { "type": "string", "maxLength": 60 },
        "agent": { "type": "string", "maxLength": 360 },
        "cat": { "type": "string", "minLength": 1, "maxLength": 200 },
        "price": { "type": "number" },
        "paid": { "type": "number" },
        "paidTo": { "type": "string", "maxLength": 200 },
        "payRef": { "type": "string", "maxLength": 200 },
        "note": { "type": "string", "maxLength": 750 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "no", "name", "phone", "agent", "cat", "price", "paid", "paidTo", "payRef", "note", "createdAt", "updatedAt"]
    },
    "StaffMember": {
      "title": "Staff Member",
      "description": "Center staff profile and monthly salary rate.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 1, "maxLength": 20 },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "role": { "type": "string", "minLength": 1, "maxLength": 80 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 140 },
        "nid": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 200 },
        "joinDate": { "type": "string", "maxLength": 20 },
        "bio": { "type": "string", "maxLength": 250 },
        "salary": { "type": "number" },
        "paid": { "type": "number" },
        "month": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "name", "role", "phone", "email", "nid", "address", "joinDate", "bio", "salary", "paid", "month", "createdAt", "updatedAt"]
    },
    "StaffPayment": {
      "title": "Staff Payment",
      "description": "Historical staff salary disbursement entry.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 1, "maxLength": 20 },
        "staffId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "staffName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "month": { "type": "string", "minLength": 1, "maxLength": 30 },
        "amount": { "type": "number" },
        "method": { "type": "string", "maxLength": 40 },
        "note": { "type": "string", "maxLength": 200 },
