        "amount": { "type": "number" },
        "remarks": { "type": "string", "maxLength": 250 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "itemId", "code", "itemName", "movement", "qty", "shop", "memo", "amount", "remarks", "createdAt", "updatedAt"]
    },
    "JobPrice": {
      "title": "Job Price & Quota Limit",
