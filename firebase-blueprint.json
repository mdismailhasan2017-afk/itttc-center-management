        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "companyName", "country", "trade", "workersCount", "status", "note", "createdAt", "updatedAt"]
    },
    "StoreItem": {
      "title": "Store Item",
